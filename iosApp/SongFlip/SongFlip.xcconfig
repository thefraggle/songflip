// Base configuration for SongFlip iOS targets
// To configure keys for local development, create Config.xcconfig (gitignored, see Config.example.xcconfig).
// In CI builds, keys are injected dynamically or via Config.xcconfig.

REVENUECAT_PUBLIC_KEY = 
APTABASE_APP_KEY = 
APTABASE_HOST = https://telemetry-apps.goork.de

OTHER_LDFLAGS = $(inherited) -lsqlite3

#include? "Config.xcconfig"

