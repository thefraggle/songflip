    "setup_card_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Musik-Links aus Chats, Browser & Co. automatisch in deinem Wunsch-Player starten, muss Android die Links einmalig an SongFlip übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To let music links from chats, browsers, and other apps open directly in your target player, Android needs a one-time link approval."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at musiklinks åbner direkte i din foretrukne afspiller, skal Android godkende SongFlip én gang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For at musikklenker skal åpnes direkte i din favorittspiller, må Android godkjenne SongFlip én gang."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "For at musikklenker skal åpnes direkte i din favorittspiller, må Android godkjenne SongFlip én gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att musiklänkar ska öppnas direkt i din favoritspelare krävs ett engångsgodkännande i Android för SongFlip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om muzieklinks direct in je favoriete speler te openen, moet Android links eenmalig toewijzen aan SongFlip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les liens musicaux reçus s'ouvrent directement dans votre lecteur préféré, Android doit autoriser SongFlip une seule fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que los enlaces de música se abran directamente en tu reproductor preferido, Android debe autorizar a SongFlip una sola vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affinché i link musicali si aprano direttamente nel tuo player preferito, Android richiede un'autorizzazione una tantum per SongFlip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que os links de música abram direto no seu player preferido, o Android precisa de uma autorização única para o SongFlip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby linki muzyczne otwierały się bezpośrednio w wybranym odtwarzaczu, Android wymaga jednorazowej zgody dla SongFlip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы ссылки на музыку открывались сразу в любимом плеере, Android требует единоразового разрешения для SongFlip."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik bağlantılarının doğrudan tercih ettiğiniz oynatıcıda açılması için Android'in SongFlip'e tek seferlik izin vermesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб музичні посилання відкривалися одразу в улюбленому плеєрі, Android вимагає одноразового дозволу для SongFlip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽リンクをお好みのプレーヤーで直接開くには、Android側でSongFlipへの一度のリンク承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 링크를 선호하는 플레이어에서 바로 열려면 Android에서 SongFlip을 한 번 승인해야 합니다. "
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要让音乐链接直接在你的常用播放器中打开，需要允许 Android 一次性将链接交由 SongFlip 处理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要让音乐链接直接在你的常用播放器中打开，需要允许 Android 一次性将链接交由 SongFlip 处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要让音乐链接直接在你的常用播放器中打开，需要允许 Android 一次性将链接交由 SongFlip 处理。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar tautan musik terbuka langsung di pemutar favorit Anda, Android memerlukan konfirmasi tautan satu kali untuk SongFlip."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar tautan musik terbuka langsung di pemutar favorit Anda, Android memerlukan konfirmasi tautan satu kali untuk SongFlip."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để liên kết nhạc mở trực tiếp trong trình phát yêu thích, Android cần cấp quyền liên kết một lần cho SongFlip."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিউজিক লিঙ্ক সরাসরি আপনার প্রিয় প্লেয়ারে খুলতে, Android-এ SongFlip-এর জন্য একবার অনুমোদনের প্রয়োজন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "म्यूजिक लिंक सीधे आपके पसंदीदा प्लेयर में खोलने के लिए, Android को SongFlip के लिए एक बार अनुमति की आवश्यकता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत लिंक्स थेट तुमच्या आवडत्या प्लेयरमध्ये उघडण्यासाठी, Android ला SongFlip साठी एक वेळ परवानगी आवश्यक आहे।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se hudební odkazy z chatů, prohlížečů a dalších aplikací otevíraly přímo v cílovém přehrávači, Android potřebuje jednorázové schválení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ανοίγουν οι σύνδεσμοι από συνομιλίες, προγράμματα περιήγησης κ.λπ. απευθείας στην εφαρμογή σας, το Android χρειάζεται εφάπαξ έγκριση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta viestien, selainten ja muiden sovellusten musiikkilinkit avautuisivat suoraan kohdesoittimessa, Android tarvitsee kertaluonteisen hyväksynnän."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahhoz, hogy a csevegésekből, böngészőkből származó zenei linkek közvetlenül a céllejátszóban nyíljanak meg, az Androidnak egyszeri jóváhagyásra van szüksége."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru ca linkurile muzicale din chat-uri, browsere și alte aplicații să se deschidă direct în playerul dorit, Android necesită o aprobare unică."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ลิงก์เพลงจากการแชท เบราว์เซอร์ และแอปอื่นๆ เปิดในเครื่องเล่นเป้าหมายได้โดยตรง Android ต้องการการอนุมัติลิงก์แบบครั้งเดียว"
          }
        }
      }
    },
    "setup_card_tip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Über das Teilen-Menü und die Zwischenablage funktioniert SongFlip sofort ohne jedes Setup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: SongFlip also works instantly without setup via the Share Sheet and Clipboard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: SongFlip fungerer også øjeblikkeligt uden opsætning via delingsmenuen og udklipsholderen."
          }
        },
        "nb": {
          "stringUnit": {
