    "custom_api_url_helper": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Wird aufgerufen, falls Odesli überlastet ist oder fehlschlägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: If set, SongFlip calls this webhook if Odesli rate-limits or fails."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit: SongFlip kalder denne webhook, hvis Odesli begrænses eller fejler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt: SongFlip kaller denne webhooken hvis Odesli feiler eller rate-begrenses."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt: SongFlip kaller denne webhooken hvis Odesli feiler eller rate-begrenses."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt: SongFlip anropar denna webhook om Odesli rate-begränsas eller misslyckas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel: SongFlip roept deze webhook aan als Odesli faalt of gelimiteerd is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel : SongFlip appelle ce webhook si Odesli atteint sa limite ou échoue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: SongFlip llama a este webhook si Odesli supera el límite de peticiones o falla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzionale: SongFlip richiama questo webhook se Odesli fallisce o raggiunge il limite."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: o SongFlip chama este webhook se o Odesli atingir o limite ou falhar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie: SongFlip wywołuje ten webhook, jeśli Odesli przekroczy limit zapytań lub zawiedzie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: вызывается, если Odesli возвращает ошибку или лимит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: Odesli hız sınırına takılırsa veya başarısız olursa SongFlip bu webhook'u çağırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов'язково: викликається, якщо Odesli повертає помилку або ліміт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意: Odesliがレート制限やエラーになった場合に呼び出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: Odesli 속도 제한 또는 오류 발생 시 호출됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：如果 Odesli 触发频率限制或失败，SongFlip 将调用此 Webhook。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：如果 Odesli 触发频率限制或失败，SongFlip 将调用此 Webhook。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：如果 Odesli 触发频率限制或失败，SongFlip 将调用此 Webhook。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: SongFlip memanggil webhook ini jika Odesli terkena batasan atau gagal."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: SongFlip memanggil webhook ini jika Odesli terkena batasan atau gagal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: SongFlip sẽ gọi webhook này nếu Odesli bị giới hạn hoặc lỗi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: Odesli ব্যর্থ হলে SongFlip এই ওয়েবহুকটি কল করে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: यदि Odesli विफल होता है तो SongFlip इस वेबहुक को कॉल करता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी: Odesli अयशस्वी झाल्यास SongFlip या वेबहुकला कॉल करतो."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné: SongFlip zavolá tento webhook, pokud Odesli selže nebo narazí na limit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό: Εάν οριστεί, το SongFlip καλεί αυτό το webhook εάν το Odesli αποτύχει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen: Jos määritetty, SongFlip kutsuu tätä webhookia, jos Odesli saavuttaa rajan tai epäonnistuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális: Ha be van állítva, a SongFlip ezt a webhookot hívja meg, ha az Odesli korlátozva van vagy hibát jelez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional: Dacă este setat, SongFlip apelează acest webhook dacă Odesli este limitat sau eșuează."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ: หากตั้งค่าไว้ SongFlip จะเรียกใช้ Webhook นี้หาก Odesli ขัดข้อง"
          }
        }
      }
