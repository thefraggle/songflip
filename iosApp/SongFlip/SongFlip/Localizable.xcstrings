    "setup_card_active_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik-Links aus allen unterstützten Streaming-Diensten öffnen sich ab jetzt automatisch im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported music links will now automatically open in your preferred player in the background."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Understøttede musiklinks åbnes nu automatisk i baggrunden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Støttede musikklenker åpnes nå automatisk i bakgrunnen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Støttede musikklenker åpnes nå automatisk i bakgrunnen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiklänkar som stöds öppnas nu automatiskt i bakgrunden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondersteunde muzieklinks openen vanaf nu automatisch op de achtergrond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens musicaux compatibles s'ouvriront désormais automatiquement en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces compatibles se abrirán a partir de ahora automáticamente en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link musicali supportati si apriranno ora automaticamente in background nel tuo player."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links de música suportados agora abrem automaticamente em segundo plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługiwane linki muzyczne będą się teraz otwierać automatycznie w tle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаемые ссылки на музыку теперь открываются автоматически в фоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen müzik bağlantıları artık arka planda otomatik olarak açılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримувані посилання відтепер відкриватимуться автоматично у фоновому режимі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する音楽リンクがバックグラウンドで自動的に開くようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 음악 링크가 이제 백그라운드에서 자동으로 열립니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击支持的音乐链接将自动在后台转换并打开。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击支持的音乐链接将自动在后台转换并打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点击支持的音乐链接将自动在后台转换并打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik yang didukung kini akan terbuka secara otomatis di latar belakang."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik yang didukung kini akan terbuka secara otomatis di latar belakang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các liên kết nhạc được hỗ trợ giờ đây sẽ tự động mở ở chế độ nền."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত সঙ্গীত লিঙ্কগুলি এখন ব্যাকগ্রাউন্ডে স্বয়ংক্রিয়ভাবে খুলবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित म्यूजिक लिंक अब बैकग्राउंड में अपने आप खुल जाएंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित संगीत लिंक्स आता बॅकग्राउंडमध्ये आपोआप उघडतील."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporované hudební odkazy se nyní automaticky otevřou na pozadí ve vašem preferovaném přehrávači."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υποστηριζόμενοι σύνδεσμοι μουσικής θα ανοίγουν τώρα αυτόματα στο παρασκήνιο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuetut musiikkilinkit avautuvat nyt automaattisesti taustalla haluamassasi soittimessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A támogatott zenei linkek mostantól automatikusan a kívánt lejátszóban nyílnak meg a háttérben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile muzicale acceptate se vor deschide acum automat în fundal în playerul preferat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์เพลงที่รองรับจะเปิดในเครื่องเล่นที่คุณต้องการในเบื้องหลังโดยอัตโนมัติ"
          }
        }
      }
    },
