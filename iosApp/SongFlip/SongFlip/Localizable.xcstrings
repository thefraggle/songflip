    "playlist_spotify_limit_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Spotify stellt ohne Account-Verbindung öffentlich maximal die ersten 100 Titel einer Playlist bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice: Without an account connection, Spotify publicly provides a maximum of the first 100 songs of a playlist."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bemærk: Uden en kontoforbindelse stiller Spotify offentligt maksimalt de første 100 sange til rådighed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk: Uten en kontotilkobling gjør Spotify offentlig tilgjengelig maksimalt de første 100 sangene."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk: Uten en kontotilkobling gjør Spotify offentlig tilgjengelig maksimalt de første 100 sangene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obs: Utan ett anslutet konto tillhandahåller Spotify offentligt maximalt de första 100 låtarna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opmerking: Zonder gekoppeld account stelt Spotify openbaar maximaal de eerste 100 nummers beschikbaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : Sans connexion de compte, Spotify ne met publiquement à disposition que les 100 premiers titres d'une playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Sin conectar una cuenta, Spotify ofrece públicamente un máximo de las primeras 100 canciones de una lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Senza collegare un account, Spotify rende disponibili pubblicamente al massimo i primi 100 brani di una playlist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Sem conectar uma conta, o Spotify disponibiliza publicamente no máximo as primeiras 100 músicas de uma playlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: Bez połączenia z kontem Spotify udostępnia publicznie maksymalnie 100 pierwszych utworów z playlisty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание: Без привязки аккаунта Spotify делает общедоступными не более первых 100 треков плейлиста."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not: Hesap bağlantısı olmadan Spotify, bir çalma listesinin herkese açık olarak en fazla ilk 100 şarkısını sunar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Примітка: Без підключення облікового запису Spotify публічно надає щонайбільше перші 100 треків списку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注意: アカウント連携がない場合、Spotifyは公開プレイリストの最初の最大100曲のみを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고: 계정을 연결하지 않으면 Spotify는 공개 재생목록의 최대 100곡까지만 제공합니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在未绑定账户的情况下，Spotify 公开最多仅提供歌单的前 100 首歌曲。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在未绑定账户的情况下，Spotify 公开最多仅提供歌单的前 100 首歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在未绑定账户的情况下，Spotify 公开最多仅提供歌单的前 100 首歌曲。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan: Tanpa tautan akun, Spotify hanya menyediakan maksimal 100 lagu pertama dari daftar putar secara publik."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan: Tanpa tautan akun, Spotify hanya menyediakan maksimal 100 lagu pertama dari daftar putar secara publik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ý: Nếu không kết nối tài khoản, Spotify chỉ cung cấp công khai tối đa 100 bài hát đầu tiên của danh sách phát."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি: অ্যাকাউন্ট সংযোগ ছাড়া Spotify सर्वজনীনভাবে একটি প্লেলিস্টের সর্বোচ্চ প্রথম ১০০টি গান সরবরাহ করে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना: बिना खाता जोड़े, Spotify सार्वजनिक रूप से किसी प्लेलिस्ट के अधिकतम पहले 100 गाने ही उपलब्ध कराता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टीप: खाते जोडल्याशिवाय Spotify सार्वजनिकरीत्या प्लेलिस्टची कमाल पहिली 100 गाणीच उपलब्ध करून देते."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění: Bez propojení účtu poskytuje Spotify veřejně maximálně prvních 100 skladeb playlistu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημείωση: Χωρίς σύνδεση λογαριασμού, το Spotify παρέχει δημόσια έως τα πρώτα 100 τραγούδια μιας λίστας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomautus: Ilman tiliyhteyttä Spotify tarjoaa julkisesti enintään soittolistan ensimmäiset 100 kappaletta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjegyzés: Fiók csatlakoztatása nélkül a Spotify nyilvánosan legfeljebb a lejátszási lista első 100 dalát biztosítja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notă: Fără conectarea unui cont, Spotify oferă public maximum primele 100 de melodii ale unui playlist."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเหตุ: หากไม่มีการเชื่อมต่อบัญชี Spotify จะเปิดเผยเพลย์ลิสต์สูงสุดเพียง 100 เพลงแรกเท่านั้น"
          }
        }
      }
    },
