      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte SongFlip PRO frei für unbegrenzte Playlist-Konvertierung bis zu 200 Songs!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
