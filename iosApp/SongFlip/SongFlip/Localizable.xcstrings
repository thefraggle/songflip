    "favorite_limit_reached": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine 10 kostenlosen Favoriten erreicht. Sichere dir SongFlip PRO für unbegrenzte Favoriten & 100 Verlaufs-Einträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached your 10 free favorites. Get SongFlip PRO for unlimited favorites & 100 history entries."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nået dine 10 gratis favoritter. Få SongFlip PRO for ubegrænsede favoritter og 100 historikposter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd dine 10 gratis favoritter. Skaff deg SongFlip PRO for ubegrensede favoritter og 100 historikkoppføringer."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd dine 10 gratis favoritter. Skaff deg SongFlip PRO for ubegrensede favoritter og 100 historikkoppføringer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nått dina 10 gratisfavoriter. Skaffa SongFlip PRO för obegränsade favoriter och 100 historikposter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je 10 gratis favorieten bereikt. Neem SongFlip PRO voor onbeperkte favorieten & 100 geschiedenisitems."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint vos 10 favoris gratuits. Passez à SongFlip PRO pour des favoris illimités et 100 entrées d'historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tus 10 favoritos gratuitos. Consigue SongFlip PRO para tener favoritos ilimitados y 100 entradas en el historial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto i tuoi 10 preferiti gratuiti. Ottieni SongFlip PRO per preferiti illimitati e 100 voci in cronologia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu seus 10 favoritos gratuitos. Obtenha o SongFlip PRO para favoritos ilimitados e 100 entradas no histórico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit 10 darmowych ulubionych. Odblokuj SongFlip PRO, aby zyskać nielimitowane ulubione i 100 wpisów w historii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли лимита в 10 бесплатных избранных треков. Перейдите на SongFlip PRO для безлимитного избранного и 100 записей в истории."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 ücretsiz favori sınırına ulaştınız. Sınırsız favori ve 100 geçmiş kaydı için SongFlip PRO edinin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви досягли ліміту в 10 безкоштовних обраних. Отримайте SongFlip PRO для необмежених обраних та 100 записів в історії."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のお気に入り上限（10件）に達しました。SongFlip PROでお気に入り無制限と履歴100件をアンロックしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 즐겨찾기 10개 한도에 도달했습니다. SongFlip PRO로 무제한 즐겨찾기와 기록 100개를 이용하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到 10 个免费收藏上限。升级 SongFlip PRO 解锁无限收藏与 100 条历史记录。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到 10 个免费收藏上限。升级 SongFlip PRO 解锁无限收藏与 100 条历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到 10 个免费收藏上限。升级 SongFlip PRO 解锁无限收藏与 100 条历史记录。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai batas 10 favorit gratis. Dapatkan SongFlip PRO untuk favorit tanpa batas & 100 entri riwayat."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai batas 10 favorit gratis. Dapatkan SongFlip PRO untuk favorit tanpa batas & 100 entri riwayat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt giới hạn 10 mục yêu thích miễn phí. Nâng cấp SongFlip PRO để mở khóa yêu thích không giới hạn & 100 mục lịch sử."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আপনার ১০টি ফ্রি ফেভারিট পূর্ণ করেছেন। আনলিমিটেড ফেভারিট ও ১০০টি হিস্ট্রি এন্ট্রির জন্য SongFlip PRO নিন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपने 10 मुफ़्त पसंदीदा पूरे कर लिए हैं। असीमित पसंदीदा और 100 हिस्ट्री एंट्री के लिए SongFlip PRO प्राप्त करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे १० मोफत फेव्हरेट्स पूर्ण झाले आहेत. अमर्यादित फेव्हरेट्स आणि १०० हिस्ट्री नोंदींसाठी SongFlip PRO घ्या."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhli jste limitu 10 bezplatných oblíbených. Pořiďte si SongFlip PRO pro neomezené oblíbené a 100 položek v historii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτάσατε τα 10 δωρεάν αγαπημένα σας. Αποκτήστε το SongFlip PRO για απεριόριστα αγαπημένα και 100 εγγραφές ιστορικού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut 10 ilmaisen suosikin rajan. Hanki SongFlip PRO saadaksesi rajattomat suosikit ja 100 historiamerkintää."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérted a 10 ingyenes kedvencet. Szerezd meg a SongFlip PRO-t a korlátlan kedvencekért és 100 előzményért."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai atins limita de 10 favorite gratuite. Obține SongFlip PRO pentru favorite nelimitate și 100 de intrări în istoric."
          }
        },
        "th": {
