          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kanan pada deretan ikon aplikasi dan ketuk 'Lainnya' (⋯)."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kanan pada deretan ikon aplikasi dan ketuk 'Lainnya' (⋯)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang phải trong danh sách ứng dụng và chạm 'Thêm' (⋯)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ সারিতে ডানে স্ক্রোল করুন এবং 'আরও' (⋯) চাপুন।"
