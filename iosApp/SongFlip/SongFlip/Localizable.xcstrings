          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Régebbi Android verziókon az állapot nem ellenőrizhető."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Starea nu poate fi verificată pe versiunile mai vechi de Android."
          }
        },
        "th": {
