    "podcast_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip is specialized in music tracks and albums. Podcasts and audiobooks are not currently supported for cross-platform flipping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip ist auf Musiktitel und Alben spezialisiert. Podcasts und Hörbücher werden derzeit nicht für die plattformübergreifende Weiterleitung unterstützt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip er specialiseret i musiknumre og albummer. Podcasts og lydbøger understøttes i øjeblikket ikke til konvertering."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip er spesialisert på musikkspor og album. Podkaster og lydbøker støttes for øyeblikket ikke for konvertering."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip är specialiserat på musikspår och album. Poddar och ljudböcker stöds inte för närvarande."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip is gespecialiseerd in muzieknummers en albums. Podcasts en audioboeken worden momenteel niet ondersteund voor conversie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip est spécialisé dans les morceaux et albums. Les podcasts et livres audio ne sont pas pris en charge pour la conversion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip está especializado en canciones y álbumes. Actualmente no se admiten pódcasts ni audiolibros para conversión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip è specializzato in brani musicali e album. I podcast e gli audiolibri non sono attualmente supportati per la conversione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SongFlip é especializado em músicas e álbuns. Podcasts e audiolivros não são suportados para conversão no momento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip specjalizuje się w utworach muzycznych i albumach. Podcasty i audiobooki nie są obecnie obsługiwane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip специализируется на музыкальных треках и альбомах. Подкасты и аудиокниги в настоящее время не поддерживаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip müzik parçaları ve albümler konusunda uzmanlaşmıştır. Podcastler ve sesli kitaplar şu anda desteklenmemektedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip спеціалізується на музичних треках та альбомах. Подкасти та аудіокниги наразі не підтримуються."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlipは楽曲とアルバムに特化しています。ポッドキャストおよびオーディオブックは現在変換に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip은 음악 트랙 및 앨범에 특화되어 있습니다. 팟캐스트와 오디오북은 현재 변환을 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 专注于音乐曲目和专辑。目前暂不支持播客和有声书的跨平台转换。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip dikhususkan untuk lagu dan album musik. Podcast dan buku audio saat ini belum didukung untuk konversi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip chuyên về các bản nhạc và album. Podcast và sách nói hiện chưa được hỗ trợ chuyển đổi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip সঙ্গীত ট্র্যাক এবং অ্যালবামে বিশেষজ্ঞ। পডকাস্ট এবং অডিওবুক বর্তমানে সমর্থित নয়।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip संगीत ट्रैक और एल्बम के लिए विशिष्ट है। पॉडकास्ट और ऑडियोबुक वर्तमान में समर्थित नहीं हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip गाणी आणि अल्बमसाठी विशेषीकृत आहे. पॉडकास्ट आणि ऑडिओबुक सध्या समर्थित नाहीत."
          }
        }
      }
    },
