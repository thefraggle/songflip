        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify、Apple Music、YouTubeで「共有」➔「SongFlip」をタップして瞬時に再生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify, Apple Music, YouTube에서 공유 ➔ SongFlip을 누르면 즉시 재생됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Spotify、Apple Music 或 YouTube 中点击分享 ➔ 选择 SongFlip 即可立即跳转播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
