            "value": "Aucun morceau converti. Les liens partagés apparaîtront ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay canciones convertidas. Los enlaces compartidos aparecerán aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun brano convertito. I link musicali condivisi appariranno qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma música convertida ainda. Links de música compartilhados aparecerão aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przekonwertowanych utworów. Udostępnione linki pojawią się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет сконвертированных треков. Ссылки появятся здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz dönüştürülmüş şarkı yok. Paylaşılan müzik bağlantıları burada görünecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає перетворених треків. Тут автоматично з'являтимуться конвертовані посилання."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換された楽曲はまだありません。共有されたリンクがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 변환된 곡이 없습니다. 공유된 음악 링크가 여기에 자동으로 표시됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无转换记录。分享的音乐链接将显示在这里。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无转换记录。分享的音乐链接将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无转换记录。分享的音乐链接将显示在这里。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada lagu yang dikonversi. Tautan musik yang dialihkan akan muncul otomatis di sini."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada lagu yang dikonversi. Tautan musik yang dialihkan akan muncul otomatis di sini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có bài hát nào được chuyển đổi. Các liên kết âm nhạc đã chuyển đổi sẽ tự động xuất hiện tại đây."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো গান রূপান্তর করা হয়নি। শেয়ার করা লিঙ্কগুলি এখানে স্বয়ংক্রিয়ভাবে প্রদর্শিত হবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई कनवर्ट किया गया गाना नहीं है। शेयर किए गए लिंक यहाँ अपने आप दिखाई देंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्याप कोणतीही गाणी रूपांतरित केलेली नाहीत. शेअर केलेल्या लिंक्स येथे आपोआप दिसतील."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné převedené skladby. Otevřené hudební odkazy se zde automaticky zobrazí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη κομμάτια. Οι ανακατευθυνόμενοι σύνδεσμοι θα εμφανίζονται αυτόματα εδώ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä muunnettuja kappaleita. Uudelleenohjatut linkit tulevat näkyviin tänne automaattisesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek átalakított zenék. Az átirányított linkek automatikusan itt jelennek meg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio melodie convertită încă. Linkurile redirecționate vor apărea automat aici."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเพลงที่แปลง ลิงก์ที่เปิดจะปรากฏที่นี่โดยอัตโนมัติ"
          }
        }
      }
    },
