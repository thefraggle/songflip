    "listen_quota_reached_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle %1$d kostenlosen Song-Erkennungen für diesen Monat genutzt. Hol dir SongFlip PRO für unbegrenztes Listen & Flip und den Offline-Club-Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have used all %1$d free song identifications this month. Unlock SongFlip PRO for unlimited Listen & Flip and Offline Club Mode."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brugt alle %1$d gratis sanggenkendelser i denne måned. Lås op for SongFlip PRO for ubegrænset Listen & Flip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle %1$d gratis sanggjenkjenninger denne måneden. Lås opp SongFlip PRO for ubegrenset Listen & Flip."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle %1$d gratis sanggjenkjenninger denne måneden. Lås opp SongFlip PRO for ubegrenset Listen & Flip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har använt alla %1$d gratis låtidentifieringar denna månad. Lås upp SongFlip PRO för obegränsad Listen & Flip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt alle %1$d gratis muziekherkenningen voor deze maand gebruikt. Ontgrendel SongFlip PRO voor onbeperkt Listen & Flip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé vos %1$d reconnaissances gratuites ce mois-ci. Débloquez SongFlip PRO pour un accès illimité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado las %1$d identificaciones gratuitas de este mes. Desbloquea SongFlip PRO para usar Listen & Flip sin límites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai utilizzato tutti i %1$d riconoscimenti gratuiti di questo mese. Sblocca SongFlip PRO per Listen & Flip illimitato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou todas as %1$d identificações gratuitas deste mês. Desbloqueie o SongFlip PRO para uso ilimitado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystałeś wszystkie %1$d darmowe rozpoznania w tym miesiącu. Odblokuj SongFlip PRO, aby skanować bez limitu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали все %1$d бесплатных распознаваний в этом месяце. Откройте SongFlip PRO для безлимитного доступа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki %1$d ücretsiz şarkı tanıma hakkınızı kullandınız. Sınırsız Listen & Flip için SongFlip PRO'yu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали всі %1$d безкоштовних розпізнавань цього місяця. Розблокуйте SongFlip PRO для безлімітного доступу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の無料認識（%1$d回）をすべて使用しました。SongFlip PROで無制限の認識とオフラインモードを解放しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 무료 곡 인식 %1$d회를 모두 사용했습니다. 무제한 인식을 위해 SongFlip PRO를 잠금 해제하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用完本月全部 %1$d 次免费识曲。解锁 SongFlip PRO 畅享无限次识曲与离线模式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用完本月全部 %1$d 次免费识曲。解锁 SongFlip PRO 畅享无限次识曲与离线模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用完本月全部 %1$d 次免费识曲。解锁 SongFlip PRO 畅享无限次识曲与离线模式。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menggunakan semua %1$d pengenalan lagu gratis bulan ini. Buka SongFlip PRO untuk akses tanpa batas."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menggunakan semua %1$d pengenalan lagu gratis bulan ini. Buka SongFlip PRO untuk akses tanpa batas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết %1$d lượt nhận diện miễn phí tháng này. Mở khóa SongFlip PRO để dùng không giới hạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই মাসের সবকটি (%1$d) ফ্রি গান শনাক্তকরণ ব্যবহার করেছেন। আনলিমিটেড অ্যাক্সেসের জন্য SongFlip PRO আনলক করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस महीने के सभी %1$d मुफ़्त स्कैन इस्तेमाल कर लिए हैं। अनलिमिटेड Listen & Flip के लिए SongFlip PRO अनलॉक करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही या महिन्याचे सर्व %1$d मोफत स्कॅन वापरले आहेत. अमर्यादित वापरासाठी SongFlip PRO अनलॉक करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Využili jste všech %1$d bezplatných rozpoznání v tomto měsíci. Odemkněte SongFlip PRO pro neomezené použití."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήσατε και τις %1$d δωρεάν αναγνωρίσεις αυτού του μήνα. Ξεκλειδώστε το SongFlip PRO για απεριόριστη χρήση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet käyttänyt kaikki %1$d ilmaista tunnistusta tässä kuussa. Avaa SongFlip PRO saadaksesi rajattomat tunnistukset."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elhasználtad mind a(z) %1$d ingyenes zenefelismerést ebben a hónapban. Oldd fel a SongFlip PRO-t a korlátlan használathoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai folosit toate cele %1$d identificări gratuite din această lună. Deblochează SongFlip PRO pentru acces nelimitat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้สิทธิ์ค้นหาเพลงฟรีครบ %1$d ครั้งในเดือนนี้แล้ว ปลดล็อก SongFlip PRO เพื่อใช้งานแบบไม่จำกัด"
          }
        }
      }
    },
