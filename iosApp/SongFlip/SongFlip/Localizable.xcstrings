    "history_clear_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle gespeicherten Songs gelöscht und der lokale Cache zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove all converted songs from history and reset your local cache."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle gemte sange og nulstiller din lokale cache."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil slette alle lagrede sanger og tilbakestille din lokale hurtigbuffer."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil slette alle lagrede sanger og tilbakestille din lokale hurtigbuffer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar alla sparade låtar och återställer din lokala cache."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle opgeslagen nummers verwijderd en de lokale cache gereset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera tous les morceaux enregistrés et réinitialisera le cache local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todas las canciones guardadas y restablecerá la caché local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuoverà tutti i brani salvati e reimposterà la cache locale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá todas as músicas salvas e redefinirá o cache local."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich zapisanych utworów i zresetowanie pamięci podręcznej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все сохраненные треки и очистит локальный кэш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kayıtlı tüm şarkıları silecek ve yerel önbelleği sıfırlayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить усі збережені треки та очистить локальний кеш."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたすべての曲が削除され、ローカルキャッシュがリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 곡이 삭제되고 로컬 캐시가 초기화됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有已保存的歌曲并重置本地缓存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有已保存的歌曲并重置本地缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有已保存的歌曲并重置本地缓存。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua lagu yang dikonversi dari riwayat dan mengatur ulang cache lokal Anda."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua lagu yang dikonversi dari riwayat dan mengatur ulang cache lokal Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tất cả các bài hát đã chuyển đổi khỏi lịch sử và đặt lại bộ nhớ đệm cục bộ của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ইতিহাস থেকে সমস্ত রূপান্তরিত গান সরিয়ে দেবে এবং আপনার স্থানীয় ক্যাশে রিসেট করবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इतिहास से सभी कनवर्ट किए गए गानों को हटा देगा और आपके स्थानीय कैश को रीसेट कर देगा।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे इतिहासातील सर्व रूपांतरित गाणी काढून टाकेल आणि तुमचा स्थानिक कॅशे रीसेट करेल."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto odstraníte všechny převedené skladby z historie a resetujete místní mezipaměť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα καταργήσει όλα τα μετατραπέντα κομμάτια από το ιστορικό και θα επαναφέρει την τοπική προσωρινή μνήμη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki muunnetut kappaleet historiasta ja nollaa paikallisen välimuistin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja az összes átalakított zenét az előzményekből és visszaállítja a helyi gyorsítótárat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va elimina toate melodiile convertite din istoric și va reseta memoria cache locală."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบเพลงที่แปลงแล้วทั้งหมดออกจากประวัติและรีเซ็ตแคชในเครื่อง"
          }
        }
      }
    },
