            "value": "এই অ্যালবামটি এখনও স্ট্রিমিং প্ল্যাটফর্মে প্রকাশিত হয়নি।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एल्बम अभी स्ट्रीमिंग प्लेटफ़ॉर्म पर उपलब्ध नहीं है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा अल्बम अद्याप स्ट्रीमिंग प्लॅटफॉर्मवर उपलब्ध नाही."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto album zatím nebylo vydáno na streamovacích platformách."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το άλμπουμ δεν έχει κυκλοφορήσει ακόμη στις πλατφόρμες streaming."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä albumia ei ole vielä julkaistu suoratoistopalveluissa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az album még nem jelent meg a streaming felületeken."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest album nu este încă disponibil pe platformele de streaming."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัลบั้มนี้ยังไม่เปิดให้ฟังบนแพลตฟอร์มสตรีมมิง"
          }
        }
      }
    },
