        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Link de streaming não suportado – use o Listen & Flip para identificar músicas em vídeos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwany link streamingowy – użyj Listen & Flip, aby rozpoznać muzykę w filmach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемая ссылка на стриминг — используйте Listen & Flip для распознавания музыки в видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir yayın bağlantısı değil – videolardaki müziği tanımak için Listen & Flip'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непідтримуване посилання на стримінг – використовуйте Listen & Flip для розпізнавання музики у відео."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非対応のストリーミングリンクです – 動画内の音楽認識には Listen & Flip をご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 스트리밍 링크입니다 – 동영상 속 음악을 찾으려면 Listen & Flip을 사용해 보세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的流媒体链接 – 请使用 Listen & Flip 识别视频中的音乐。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
