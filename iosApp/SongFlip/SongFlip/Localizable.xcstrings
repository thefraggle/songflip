    "listen_permission_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip benötigt Zugriff auf das Mikrofon, um Musik in deiner Umgebung zu erkennen. Es werden keine Aufnahmen gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip needs microphone access to recognize music playing around you. Audio is never recorded or stored."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip skal bruge mikrofonadgang for at genkende musik omkring dig. Lyd optages eller gemmes aldrig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip trenger mikrofontilgang for å gjenkjenne musikk rundt deg. Lyd blir aldri tatt opp eller lagret."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip trenger mikrofontilgang for å gjenkjenne musikk rundt deg. Lyd blir aldri tatt opp eller lagret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip behöver mikrofonåtkomst för att känna igen musik omkring dig. Ljud spelas aldrig in eller sparas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip heeft toegang tot de microfoon nodig om muziek om je heen te herkennen. Audio wordt nooit opgeslagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip a besoin du microphone pour reconnaître la musique autour de vous. Aucun audio n'est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip necesita acceso al micrófono para reconocer la música a tu alrededor. El audio nunca se graba ni almacena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip richiede l'accesso al microfono per riconoscere la musica intorno a te. L'audio non viene mai registrato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Listen & Flip precisa do microfone para reconhecer músicas ao seu redor. Nenhum áudio é gravado ou salvo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip potrzebuje dostępu do mikrofonu, aby rozpoznawać muzykę. Dźwięk nigdy nie jest nagrywany ani zapisywany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip использует микрофон для распознавания музыки вокруг вас. Аудио никогда не записывается и не хранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip çevrenizdeki müziği tanımak için mikrofona ihtiyaç duyar. Ses asla kaydedilmez veya saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip потребує доступу до мікрофона для розпізнавання музики. Аудіо ніколи не записується і не зберігається."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の音楽を認識するためにマイクを使用します。音声が録音・保存されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip이 주변 음악을 인식하려면 마이크 권한이 필요합니다. 오디오는 절대 녹음되거나 저장되지 않습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip 需要使用麦克风来识别周围播放的音乐。音频绝不会被录音或存储。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip 需要使用麦克风来识别周围播放的音乐。音频绝不会被录音或存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip 需要使用麦克风来识别周围播放的音乐。音频绝不会被录音或存储。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip memerlukan akses mikrofon untuk mengenali musik di sekitar Anda. Audio tidak pernah direkam atau disimpan."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip memerlukan akses mikrofon untuk mengenali musik di sekitar Anda. Audio tidak pernah direkam atau disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip cần micro để nhận diện nhạc xung quanh bạn. Âm thanh không bao giờ bị ghi lại hay lưu trữ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চারপাশের গান শনাক্ত করতে মাইক্রোফোন অ্যাক্সেস প্রয়োজন। কোনো অডিও রেকর্ড বা সংরক্ষণ করা হয় না।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास के संगीत को पहचानने के लिए Listen & Flip को माइक्रोफ़ोन की आवश्यकता है। ऑडियो कभी रिकॉर्ड या सेव नहीं किया जाता।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजूबाजूचे संगीत ओळखण्यासाठी Listen & Flip ला मायक्रोफोनची गरज आहे. ऑडिओ कधीही रेकॉर्ड किंवा साठवला जात नाही."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip potřebuje mikrofon k rozpoznání okolní hudby. Zvuk se nikdy nenahrává ani neukládá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Listen & Flip χρειάζεται πρόσβαση στο μικρόφωνο για να αναγνωρίζει τη μουσική γύρω σας. Ο ήχος δεν καταγράφεται ποτέ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip tarvitsee mikrofonia ympärilläsi soivan musiikin tunnistamiseen. Ääntä ei koskaan tallenneta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Listen & Flip a mikrofont használja a körülötted szóló zene felismeréséhez. A hangot soha nem rögzítjük."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip are nevoie de microfon pentru a recunoaște muzica din jurul tău. Sunetul nu este niciodată înregistrat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip ต้องใช้ไมโครโฟนเพื่อระบุเพลงรอบตัวคุณ ระบบจะไม่บันทึกหรือจัดเก็บไฟล์เสียงใดๆ"
          }
        }
      }
    },
