          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Bagikan di Spotify, Apple Music, atau YouTube ➔ SongFlip untuk memutar langsung."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
