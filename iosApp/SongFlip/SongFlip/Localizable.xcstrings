    "step1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in Spotify, Apple Music oder YouTube auf Teilen ➔ SongFlip für den sofortigen Sprung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Share in Spotify, Apple Music or YouTube ➔ SongFlip for instant playback."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Del i Spotify, Apple Music eller YouTube ➔ SongFlip for øjeblikkelig afspilning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Del i Spotify, Apple Music eller YouTube ➔ SongFlip for direkte avspilling."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Del i Spotify, Apple Music eller YouTube ➔ SongFlip for direkte avspilling."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Dela i Spotify, Apple Music eller YouTube ➔ SongFlip för att spela direkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Delen in Spotify, Apple Music of YouTube ➔ SongFlip om direct af te spelen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Partager dans Spotify, Apple Music ou YouTube ➔ SongFlip pour lancer la lecture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Compartir en Spotify, Apple Music o YouTube ➔ SongFlip para reproducir al instante."
