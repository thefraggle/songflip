    "step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig! Empfangene Musik-Links öffnen sich ab jetzt automatisch im Hintergrund in deinem Ziel-Player."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done! Shared links automatically flip into your target player in the background."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdig! Delte links omdirigeres automatisk til din mål-afspiller i baggrunden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig! Delte lenker åpnes automatisk i din valgte spiller i bakgrunnen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig! Delte lenker åpnes automatisk i din valgte spiller i bakgrunnen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart! Delade länkar omdirigeras automatiskt till din målspelare i bakgrunden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar! Gedeelde links openen automatisch in je doelspeler op de achtergrond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé ! Les liens partagés basculent automatiquement vers votre lecteur cible en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo! Los enlaces compartidos se abren automáticamente en tu reproductor preferido en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto! I link condivisi si aprono automaticamente nel tuo lettore preferito in background."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto! Links partilhados abrem automaticamente no seu reprodutor de destino em segundo plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe! Udostępnione linki automatycznie otwierają się w Twoim odtwarzaczu docelowym w tle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово! Музыкальные ссылки автоматически открываются в выбранном плеере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı! Paylaşılan bağlantılar arka planda otomatik olarak hedef oynatıcınızda açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово! Музичні посилання автоматично відкриваються у вибраному плеєрі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了！共有されたリンクはバックグラウンドで自動的に指定のプレーヤーで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료! 공유된 링크는 백그라운드에서 대상 플레이어로 자동 변환됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "完成！分享的链接将在后台自动跳转至目标播放器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成！分享的链接将在后台自动跳转至目标播放器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成！分享的链接将在后台自动跳转至目标播放器。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai! Tautan yang dibagikan otomatis beralih ke pemutar tujuan di latar belakang."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai! Tautan yang dibagikan otomatis beralih ke pemutar tujuan di latar belakang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất! Các liên kết được chia sẻ sẽ tự động chuyển sang trình phát mục tiêu dưới nền."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন! শেয়ার করা লিঙ্কগুলি ব্যাকগ্রাউন্ডে আপনার লক্ষ্য প্লেয়ারে স্বয়ংক্রিয়ভাবে চলে যাবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया! साझा किए गए लिंक बैकग्राउंड में आपके लक्ष्य प्लेयर में स्वचालित रूप से खुलेंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झाले! शेअर केलेल्या लिंक्स पार्श्वभूमीत आपोआप तुमच्या टार्गेट प्लेअरमध्ये उघडतील."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo! Sdílené odkazy se automaticky otevřou ve vašem cílovém přehrávači."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτοιμο! Οι κοινόχρηστοι σύνδεσμοι ανοίγουν αυτόματα στην εφαρμογή αναπαραγωγής σας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis! Jaetut linkit avautuvat automaattisesti kohdesoittimessasi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kész! A megosztott linkek automatikusan megnyílnak a céllejátszóban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gata! Linkurile partajate se deschid automat în playerul țintă."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จสิ้น! ลิงก์ที่แชร์จะเปิดในเครื่องเล่นเป้าหมายของคุณโดยอัตโนมัติ"
          }
        }
      }
    },
    "step3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Musik-Links werden beim Öffnen der App automatisch erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied music links are automatically detected when opening the app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierede musiklinks registreres automatisk, når appen åbnes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte musikklenker oppdages automatisk når appen åpnes."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte musikklenker oppdages automatisk når appen åpnes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierade musiklänkar identifieras automatiskt när appen öppnas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerde muzieklinks worden direct herkend bij het openen van de app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens musicaux copiés sont automatiquement détectés à l'ouverture de l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de música copiados se detectan automáticamente al abrir la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link musicali copiati vengono rilevati automaticamente all'apertura dell'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Links de música copiados são detectados automaticamente ao abrir o app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowane linki muzyczne są automatycznie wykrywane po otwarciu aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные музыкальные ссылки автоматически распознаются при открытии приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan müzik bağlantıları uygulama açıldığında otomatik olarak algılanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопійовані музичні посилання автоматично розпізнаються під час відкриття програми."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開くとコピーした音楽リンクを自動で認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열면 복사된 음악 링크가 자동으로 감지됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时会自动识别并转换剪贴板中的音乐链接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时会自动识别并转换剪贴板中的音乐链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时会自动识别并转换剪贴板中的音乐链接。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik yang disalin akan terdeteksi otomatis saat membuka aplikasi."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik yang disalin akan terdeteksi otomatis saat membuka aplikasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết nhạc đã sao chép sẽ tự động được nhận diện khi mở ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ খুললেই কপি করা মিউজিক লিঙ্ক স্বয়ংক্রিয়ভাবে শনাক্ত হবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खोलते ही कॉपी किए गए संगीत लिंक अपने आप पहचान लिए जाते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप उघडताच कॉपी केलेल्या संगीत लिंक्स आपोआप ओळखल्या जातात."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírované hudební odkazy jsou automaticky rozpoznány při otevření aplikace."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αντιγραμμένοι σύνδεσμοι μουσικής εντοπίζονται αυτόματα κατά το άνοιγμα της εφαρμογής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioidut musiikkilinkit tunnistetaan automaattisesti sovellusta avattaessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt zenei linkeket az alkalmazás megnyitásakor automatikusan felismeri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile muzicale copiate sunt detectate automat la deschiderea aplicației."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์เพลงที่คัดลอกไว้จะถูกตรวจจับโดยอัตโนมัติเมื่อเปิดแอป"
          }
        }
      }
    },
