    "playlist_error_timeout_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Musikdienst hat nicht rechtzeitig geantwortet. Bei sehr großen Playlists kann es zu Zeitüberschreitungen kommen. Bitte versuche es erneut oder öffne das Original."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music service did not respond in time. For very large playlists, timeouts may occur. Please try again shortly or open the original."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiktjenesten svarede ikke i tide. For meget store afspilningslister kan der opstå timeout. Prøv igen snart eller åbn originalen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikktjenesten svarte ikke i tide. For svært store spillelister kan tidsavbrudd forekomme. Prøv igjen snart eller åpne originalen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikktjenesten svarte ikke i tide. For svært store spillelister kan tidsavbrudd forekomme. Prøv igjen snart eller åpne originalen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiktjänsten svarade inte i tid. För mycket stora spellistor kan timeout uppstå. Försök igen snart eller öppna originalet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De muziekdienst reageerde niet op tijd. Bij zeer grote afspeellijsten kunnen timeouts optreden. Probeer het snel opnieuw of open het origineel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service musical n'a pas répondu à temps. Pour les très grandes playlists, des délais d'attente peuvent survenir. Veuillez réessayer bientôt ou ouvrir l'original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de música no respondió a tiempo. En listas muy grandes, pueden ocurrir tiempos de espera. Inténtalo de nuevo pronto o abre el original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio musicale non ha risposto in tempo. Per playlist molto grandi potrebbero verificarsi timeout. Riprova a breve o apri l'originale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de música não respondeu a tempo. Para playlists muito grandes, podem ocorrer tempos limite. Tente novamente em breve ou abra o original."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa muzyczna nie odpowiedziała na czas. W przypadku bardzo dużych playlist może wystąpić limit czasu. Spróbuj ponownie wkrótce lub otwórz oryginał."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыкальный сервис не ответил вовремя. Для очень больших плейлистов возможно превышение времени ожидания. Повторите попытку позже или откройте оригинал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik servisi zamanında yanıt vermedi. Çok büyük çalma listelerinde zaman aşımı oluşabilir. Lütfen birazdan tekrar deneyin veya orijinali açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музичний сервіс не відповів вчасно. Для дуже великих плейлістів може виникнути тайм-аут. Спробуйте ще раз незабаром або відкрийте оригінал."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽サービスの応答がタイムアウトしました。非常に大きなプレイリストではタイムアウトが発生する場合があります。しばらくしてから再試行するか、元のリンクを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 서비스가 제시간에 응답하지 않았습니다. 매우 큰 재생목록의 경우 시간 초과가 발생할 수 있습니다. 잠시 후 다시 시도하거나 원본을 여세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐服务未及时响应。对于超大型播放列表，可能会发生超时。请稍后重试或打开原始链接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐服务未及时响应。对于超大型播放列表，可能会发生超时。请稍后重试或打开原始链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐服务未及时响应。对于超大型播放列表，可能会发生超时。请稍后重试或打开原始链接。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan musik tidak merespons tepat waktu. Untuk daftar putar yang sangat besar, waktu habis dapat terjadi. Silakan coba lagi sebentar lagi atau buka yang asli."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan musik tidak merespons tepat waktu. Untuk daftar putar yang sangat besar, waktu habis dapat terjadi. Silakan coba lagi sebentar lagi atau buka yang asli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ âm nhạc không phản hồi kịp thời. Đối với danh sách phát rất lớn, có thể xảy ra thời gian chờ. Vui lòng thử lại sau hoặc mở bản gốc."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঙ্গীত পরিষেবা সময়মতো সাড়া দেয়নি। খুব বড় প্লেলিস্টের ক্ষেত্রে সময়সীমা শেষ হতে পারে। অনুগ্রহ করে শীঘ্রই আবার চেষ্টা করুন বা আসলটি খুলুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत सेवा ने समय पर प्रतिक्रिया नहीं दी। बहुत बड़ी प्लेलिस्ट के लिए समय समाप्त हो सकता है। कृपया जल्द ही पुन: प्रयास करें या मूल खोलें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत सेवेने वेळेत प्रतिसाद दिला नाही. खूप मोठ्या प्लेलिस्टसाठी कालबाह्य होऊ शकते. कृपया लवकरच पुन्हा प्रयत्न करा किंवा मूळ उघडा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudební služba neodpověděla včas. U velmi velkých playlistů může dojít k vypršení časového limitu. Zkuste to prosím brzy znovu nebo otevřete originál."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηρεσία μουσικής δεν απάντησε εγκαίρως. Σε πολύ μεγάλες λίστες ενδέχεται να υπάρξει λήξη χρονικού ορίου. Δοκιμάστε ξανά σύντομα ή ανοίξτε το πρωτότυπο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikkipalvelu ei vastannut ajoissa. Erittäin suurilla soittolistoilla voi ilmetä aikakatkaisuja. Yritä pian uudelleen tai avaa alkuperäinen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zenei szolgáltatás nem válaszolt időben. Nagyon nagy lejátszási listáknál időtúllépés léphet fel. Kérjük, próbálja újra hamarosan, vagy nyissa meg az eredetit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul muzical nu a răspuns la timp. Pentru playlisturi foarte mari pot apărea expirări de timp. Vă rugăm să încercați din nou în curând sau deschideți originalul."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการเพลงไม่ตอบสนองทันเวลา สำหรับเพลย์ลิสต์ขนาดใหญ่มาก อาจหมดเวลาได้ โปรดลองอีกครั้งในเร็วๆ นี้ หรือเปิดเพลงต้นฉบับ"
          }
        }
      }
    },
