    "playlist_same_platform_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Playlist stammt bereits von deinem ausgewählten Musikdienst. Du kannst sie direkt in der App öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playlist is already from your selected music service. You can open it directly in the app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne playliste er allerede fra din valgte musiktjeneste. Du kan åbne den direkte i appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne spillelisten er allerede fra din valgte musikktjeneste. Du kan åpne den direkte i appen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne spillelisten er allerede fra din valgte musikktjeneste. Du kan åpne den direkte i appen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här spellistan är redan från din valda musiktjänst. Du kan öppna den direkt i appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afspeellijst is al van je geselecteerde muziekdienst. Je kunt hem direct in de app openen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette playlist provient déjà de votre service musical sélectionné. Vous pouvez l'ouvrir directement dans l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista de reproducción ya pertenece a tu servicio de música seleccionado. Puedes abrirla directamente en la aplicación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa playlist proviene già dal servizio musicale selezionato. Puoi aprirla direttamente nell'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta playlist já é do seu serviço de música selecionado. Você pode abri-la diretamente no aplicativo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta playlista pochodzi już z wybranego serwisu muzycznego. Możesz otworzyć ją bezpośrednio w aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот плейлист уже из выбранного вами музыкального сервиса. Вы можете открыть его прямо в приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalma listesi zaten seçtiğiniz müzik servisinden. Doğrudan uygulamada açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей плейлист вже з обраного вами музичного сервісу. Ви можете відкрити його безпосередньо в додатку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレイリストは選択中の音楽サービスのものです。アプリで直接開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플레이리스트는 이미 선택한 음악 서비스의 플레이리스트입니다. 앱에서 바로 열 수 있습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌单已来自您选择的音乐服务，您可以直接在应用中打开它。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌单已来自您选择的音乐服务，您可以直接在应用中打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌单已来自您选择的音乐服务，您可以直接在应用中打开它。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist ini sudah berasal dari layanan musik pilihan Anda. Anda dapat membukanya langsung di aplikasi."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist ini sudah berasal dari layanan musik pilihan Anda. Anda dapat membukanya langsung di aplikasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách phát này đã thuộc dịch vụ nhạc bạn chọn. Bạn có thể mở trực tiếp trong ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্লেলিস্টটি ইতিমধ্যেই আপনার নির্বাচিত মিউজিক সার্ভিসের। আপনি এটি সরাসরি অ্যাপে খুলতে পারেন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्लेलिस्ट पहले से ही आपकी चुनी हुई म्यूज़िक सर्विस से है। आप इसे सीधे ऐप में खोल सकते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही प्लेलिस्ट आधीच तुमच्या निवडलेल्या म्युझिक सेवेतील आहे. तुम्ही ती थेट अ‍ॅपमध्ये उघडू शकता."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento playlist již pochází z vaší vybrané hudební služby. Můžete jej otevřít přímo v aplikaci."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η λίστα αναπαραγωγής προέρχεται ήδη από την επιλεγμένη υπηρεσία μουσικής σας. Μπορείτε να την ανοίξετε απευθείας στην εφαρμογή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä soittolista on jo valitsemastasi musiikkipalvelusta. Voit avata sen suoraan sovelluksessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a lejátszási lista már a kiválasztott zenei szolgáltatásból származik. Közvetlenül megnyithatod az alkalmazásban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această listă de redare provine deja din serviciul muzical selectat. O poți deschide direct în aplicație."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลย์ลิสต์นี้มาจากบริการเพลงที่คุณเลือกอยู่แล้ว คุณสามารถเปิดในแอปได้โดยตรง"
          }
        }
      }
    },
