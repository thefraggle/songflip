    "listen_offline_saved_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio-Fingerabdruck gesichert (%1$d ausstehend). SongFlip erkennt den Song automatisch, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio fingerprint saved (%1$d pending). SongFlip will identify it automatically once you are back online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsignatur gemt (%1$d afventer). SongFlip genkender sangen automatisk, når du er online igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsignatur lagret (%1$d venter). SongFlip gjenkjenner sangen automatisk når du er på nett igjen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsignatur lagret (%1$d venter). SongFlip gjenkjenner sangen automatisk når du er på nett igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudavtryck sparat (%1$d väntar). SongFlip identifierar låten automatiskt när du är online igen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio-afdruk opgeslagen (%1$d in wachtrij). SongFlip herkent het nummer automatisch zodra je weer online bent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte audio enregistrée (%1$d en attente). SongFlip l'identifiera automatiquement dès que vous serez en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huella de audio guardada (%1$d pendiente). SongFlip la identificará automáticamente cuando vuelvas a estar en línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impronta audio salvata (%1$d in attesa). SongFlip riconoscerà il brano automaticamente appena tornerai online."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinatura de áudio salva (%1$d pendente). O SongFlip identificará a música automaticamente quando você estiver online."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odcisk audio zapisany (oczekujące: %1$d). SongFlip rozpozna utwór automatycznie, gdy wrócisz online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио-отпечаток сохранен (в очереди: %1$d). SongFlip автоматически распознает трек, когда появится сеть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses izi kaydedildi (%1$d bekliyor). İnternete bağlandığınızda SongFlip şarkıyı otomatik olarak tanıyacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо-відбиток збережено (в черзі: %1$d). SongFlip автоматично розпізнає пісню, коли з'явиться інтернет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声フィンガープリントを保存しました（保留中: %1$d件）。オンラインに戻り次第、自動的に曲名を特定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 핑거프린트가 저장되었습니다(대기 중 %1$d개). 온라인 상태가 되면 자동으로 곡을 찾아줍니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "音频指纹已保存（%1$d 首待处理）。恢复网络连接后，SongFlip 将自动为您识别。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频指纹已保存（%1$d 首待处理）。恢复网络连接后，SongFlip 将自动为您识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音频指纹已保存（%1$d 首待处理）。恢复网络连接后，SongFlip 将自动为您识别。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidik jari audio disimpan (%1$d tertunda). SongFlip akan mengenalinya secara otomatis saat Anda kembali online."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidik jari audio disimpan (%1$d tertunda). SongFlip akan mengenalinya secara otomatis saat Anda kembali online."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu dấu vân tay âm thanh (%1$d đang chờ). SongFlip sẽ tự động nhận diện khi có mạng trở lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও সিগনেচার সেভ হয়েছে (%1$dটি বাকি)। ইন্টারনেট ফিরে এলে SongFlip স্বয়ংক্রিয়ভাবে এটি শনাক্ত করবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो फ़िंगरप्रिंट सेव हो गया (%1$d बाकी)। ऑनलाइन आते ही SongFlip इसे अपने-आप पहचान लेगा।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडिओ फिंगरप्रिंट जतन केला (%1$d प्रलंबित). तुम्ही पुन्हा ऑनलाइन आल्यावर SongFlip ते आपोआप ओळखेल."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukový otisk uložen (čeká: %1$d). SongFlip skladbu automaticky rozpozná, jakmile budete opět online."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ηχητικό αποτύπωμα αποθηκεύτηκε (%1$d σε αναμονή). Το SongFlip θα το αναγνωρίσει αυτόματα μόλις συνδεθείτε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänitunniste tallennettu (%1$d odottaa). SongFlip tunnistaa kappaleen automaattisesti, kun olet taas verkossa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangmintázat elmentve (%1$d függőben). A SongFlip automatikusan felismeri, amint újra online leszel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amprenta audio a fost salvată (%1$d în așteptare). SongFlip va identifica melodia automat când revii online."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกลายนิ้วมือเสียงแล้ว (รอดำเนินการ %1$d รายการ) SongFlip จะค้นหาเพลงให้อัตโนมัติเมื่อคุณกลับมาออนไลน์"
          }
        }
      }
