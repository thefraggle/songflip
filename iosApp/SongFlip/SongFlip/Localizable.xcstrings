    "settings_tip_multiple_apps_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Dienst wie Spotify Links direkt öffnet, tippe in WhatsApp oder anderen Apps einfach auf „Teilen → SongFlip“, um Songs in deinem Wunschdienst abzuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an app like Spotify opens links directly, simply tap \"Share → SongFlip\" in WhatsApp or any app to play songs in your preferred music player."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en app som Spotify åbner links direkte, skal du blot trykke på \"Del → SongFlip\" i WhatsApp eller en hvilken som helst app for at afspille sange i din foretrukne musikafspiller."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en app som Spotify åpner lenker direkte, trykker du bare på \"Del → SongFlip\" i WhatsApp eller en hvilken som helst app for å spille av sanger i din foretrukne musikkspiller."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en app som Spotify åpner lenker direkte, trykker du bare på \"Del → SongFlip\" i WhatsApp eller en hvilken som helst app for å spille av sanger i din foretrukne musikkspiller."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om en app som Spotify öppnar länkar direkt trycker du bara på \"Dela → SongFlip\" i WhatsApp eller valfri app för att spela låtar i din favoritmusikspelare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een app zoals Spotify links direct opent, tik dan gewoon op \"Delen → SongFlip\" in WhatsApp of een willekeurige app om nummers in je favoriete muziekspeler af te spelen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une application comme Spotify ouvre directement les liens, appuyez simplement sur \"Partager → SongFlip\" dans WhatsApp ou toute autre application pour écouter des morceaux dans votre lecteur préféré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si una app como Spotify abre enlaces directamente, simplemente pulsa \"Compartir → SongFlip\" en WhatsApp o cualquier app para escuchar canciones en tu reproductor preferido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un'app come Spotify apre direttamente i link, tocca \"Condividi → SongFlip\" in WhatsApp o in qualsiasi app per riprodurre i brani nel tuo player preferito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um app como o Spotify abrir links diretamente, basta tocar em \"Compartilhar → SongFlip\" no WhatsApp ou em qualquer app para reproduzir músicas no seu player preferido."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli aplikacja taka jak Spotify otwiera linki bezpośrednio, po prostu dotknij \"Udostępnij → SongFlip\" w WhatsAppie lub dowolnej aplikacji, aby odtwarzać utwory w wybranym odtwarzaczu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если такое приложение, как Spotify, открывает ссылки напрямую, просто нажмите \"Поделиться → SongFlip\" в WhatsApp или любом другом приложении, чтобы слушать треки в любимом плеере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify gibi bir uygulama bağlantıları doğrudan açıyorsa, şarkıları tercih ettiğiniz müzik çalarınızda dinlemek için WhatsApp veya herhangi bir uygulamada \"Paylaş → SongFlip\" seçeneğine dokunmanız yeterlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо такий додаток, як Spotify, відкриває посилання напряму, просто натисніть \"Поділитися → SongFlip\" у WhatsApp або будь-якому додатку, щоб слухати треки в улюбленому плеєрі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyなどのアプリがリンクを直接開く場合は、WhatsAppなどのアプリで「共有 → SongFlip」をタップするだけで、お好みの音楽プレイヤーで曲を再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 같은 앱이 링크를 직접 여는 경우, WhatsApp 등에서 \"공유 → SongFlip\"을 탭하기만 하면 원하는 음악 플레이어에서 곡을 재생할 수 있습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果像 Spotify 这样的应用直接打开链接，只需在微信、WhatsApp 或任何应用中点击“分享 → SongFlip”，即可在您首选的播放器中播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果像 Spotify 这样的应用直接打开链接，只需在微信、WhatsApp 或任何应用中点击“分享 → SongFlip”，即可在您首选的播放器中播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果像 Spotify 这样的应用直接打开链接，只需在微信、WhatsApp 或任何应用中点击“分享 → SongFlip”，即可在您首选的播放器中播放。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aplikasi seperti Spotify langsung membuka tautan, cukup ketuk \"Bagikan → SongFlip\" di WhatsApp atau aplikasi apa pun untuk memutar lagu di pemutar musik pilihan Anda."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aplikasi seperti Spotify langsung membuka tautan, cukup ketuk \"Bagikan → SongFlip\" di WhatsApp atau aplikasi apa pun untuk memutar lagu di pemutar musik pilihan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một ứng dụng như Spotify mở liên kết trực tiếp, bạn chỉ cần nhấn vào \"Chia sẻ → SongFlip\" trong WhatsApp hoặc bất kỳ ứng dụng nào để phát bài hát trong trình phát nhạc yêu thích."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি Spotify-এর মতো কোনও অ্যাপ সরাসরি লিঙ্ক খোলে, তবে আপনার পছন্দের মিউজিক প্লেয়ারে গান চালাতে WhatsApp বা যেকোনো অ্যাপে শুধু \"শেয়ার → SongFlip\" ট্যাপ করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि Spotify जैसा कोई ऐप सीधे लिंक खोलता है, तो अपने पसंदीदा संगीत प्लेयर में गाने बजाने के लिए WhatsApp या किसी भी ऐप में बस \"साझा करें → SongFlip\" पर टैप करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify सारखे अॅप थेट लिंक्स उघडत असल्यास, आपल्या पसंतीच्या संगीत प्लेयरमध्ये गाणी प्ले करण्यासाठी WhatsApp किंवा कोणत्याही अॅपमध्ये फक्त \"शेअर करा → SongFlip\" वर टॅप करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud aplikace jako Spotify otevírá odkazy přímo, jednoduše klepněte na \"Sdílet → SongFlip\" v aplikaci WhatsApp nebo jiné aplikaci a přehrajte skladbu ve vašem oblíbeném přehrávači."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν μια εφαρμογή όπως το Spotify ανοίγει απευθείας τους συνδέσμους, απλώς πατήστε \"Κοινοποίηση → SongFlip\" στο WhatsApp ή σε οποιαδήποτε εφαρμογή για αναπαραγωγή στην εφαρμογή της επιλογής σας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sovellus, kuten Spotify, avaa linkit suoraan, napauta vain \"Jaa → SongFlip\" WhatsAppissa tai missä tahansa sovelluksessa toistaaksesi haluamassasi soittimessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy alkalmazás, például a Spotify közvetlenül nyitja meg a linkeket, egyszerűen koppintson a \"Megosztás → SongFlip\" lehetőségre a WhatsAppban vagy bármely alkalmazásban a kívánt lejátszóban való lejátszáshoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă o aplicație precum Spotify deschide linkurile direct, atingeți pur și simplu \"Partajare → SongFlip\" în WhatsApp sau orice aplicație pentru a reda melodiile în playerul preferat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากแอปอย่าง Spotify เปิดลิงก์โดยตรง เพียงแตะ \"แชร์ → SongFlip\" ใน WhatsApp หรือแอปใดก็ได้เพื่อเล่นในเครื่องเล่นที่คุณต้องการ"
          }
        }
      }
    },
