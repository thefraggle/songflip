        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải liên kết phát nhạc được hỗ trợ – hãy dùng Listen & Flip để nhận diện nhạc trong video."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত স্ট্রিমিং লিঙ্ক নয় – ভিডিওতে মিউজিক চিনতে Listen & Flip ব্যবহার করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समर्थित स्ट्रीमिंग लिंक नहीं है – वीडियो में संगीत पहचानने के लिए Listen & Flip का उपयोग करें।"
