    "shortcuts_step1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die vorinstallierte Apple-App 'Kurzbefehle' und tippe oben rechts auf das Plus (+)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple's pre-installed 'Shortcuts' app and tap the plus (+) in the top right."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Apples 'Genveje'-app og tryk på plus (+) øverst til højre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Apples 'Snarveier'-app og trykk på pluss (+) øverst til høyre."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Apples 'Snarveier'-app og trykk på pluss (+) øverst til høyre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Apples 'Genvägar'-app och tryck på plus (+) uppe till höger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de Apple 'Opdrachten'-app en tik op de plus (+) rechtsboven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'app 'Raccourcis' d'Apple et touchez le plus (+) en haut à droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app 'Atajos' de Apple y pulsa el más (+) arriba a la derecha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app 'Comandi' di Apple e tocca il più (+) in alto a destra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app 'Atalhos' da Apple e toque no mais (+) no canto superior direito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację 'Skróty' Apple i dotknij plus (+) w prawym górnym rogu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение 'Быстрые команды' Apple и нажмите плюс (+) в правом верхнем углу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 'Kestirmeler' uygulamasını açın ve sağ üstteki artı (+) simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте програму 'Швидкі команди' та торкніться плюса (+) у правому куті."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple純正の「ショートカット」アプリを開き、右上の「＋」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 '단축어' 앱을 열고 오른쪽 상단의 더하기(+)를 탭하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统自带的“快捷指令”App，轻点右上角的“+”。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统自带的“快捷指令”App，轻点右上角的“+”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统自带的“快捷指令”App，轻点右上角的“+”。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi 'Pintasan' Apple dan ketuk tambah (+) di kanan atas."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi 'Pintasan' Apple dan ketuk tambah (+) di kanan atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở app 'Phím tắt' và chạm vào dấu cộng (+) ở góc trên bên phải."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপলের 'শর্টকাট' অ্যাপ খুলুন এবং উপরে ডানে প্লাস (+) চাপুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple की 'शॉर्टकट' ऐप खोलें और ऊपर दाईं ओर प्लस (+) पर टैप करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ची 'शॉर्टकट' अ‍ॅप उघडा आणि वर उजवीकडे प्लस (+) वर टॅप करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete předinstalovanou aplikaci 'Zkratky' od Applu a klepněte na plus (+) vpravo nahoře."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την προεγκατεστημένη εφαρμογή 'Συντομεύσεις' της Apple και πατήστε το συν (+) πάνω δεξιά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Applen esiasennettu 'Pikakomennot'-sovellus ja napauta plusmerkkiä (+) oikeassa yläkulmassa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg az Apple előre telepített 'Parancsok' alkalmazását, és koppints a jobb felső sarokban lévő plusz (+) jelre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide aplicația preinstalată 'Scurtături' de la Apple și atinge semnul plus (+) din dreapta sus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอป 'คำสั่งลัด' ที่ติดตั้งมาพร้อมเครื่องของ Apple แล้วแตะเครื่องหมายบวก (+) ที่มุมขวาบน"
          }
        }
      }
    },
