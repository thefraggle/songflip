        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tautan musik masuk mana yang harus dialihkan otomatis oleh SongFlip"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn liên kết âm nhạc đến mà SongFlip sẽ tự động chuyển hướng"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন ইনকামিং মিউজিক লিঙ্কগুলি SongFlip স্বয়ংক্রিয়ভাবে ফ্লিপ করবে তা বেছে নিন"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि SongFlip को किन आने वाले संगीत लिंक को स्वचालित रूप से फ्लिप करना चाहिए"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip ने कोणत्या येणाऱ्या संगीत लिंक्स आपोआप बदलायच्या ते निवडा"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, které příchozí hudební odkazy má SongFlip automaticky převádět"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ποιους εισερχόμενους συνδέσμους θα μετατρέπει αυτόματα το SongFlip"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitkä saapuvat musiikkilinkit SongFlip muuntaa automaattisesti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, mely bejövő zenei linkeket alakítsa át automatikusan a SongFlip"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ce linkuri muzicale primite ar trebui să redirecționeze SongFlip automat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะให้ SongFlip แปลงลิงก์เพลงที่เข้ามาใดบ้างโดยอัตโนมัติ"
          }
        }
      }
    },
