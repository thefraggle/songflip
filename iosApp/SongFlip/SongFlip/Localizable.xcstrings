    "pause_dialog_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehende Musik-Links öffnen während der Pause direkt im Original-Dienst/Browser ohne Umleitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming music links will open in their original app/browser without conversion while paused."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indgående musiklinks åbnes i deres oprindelige app/browser uden konvertering, mens SongFlip er på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innkommende musikklenker åpnes i originalappen/nettleseren uten konvertering mens SongFlip er pauset."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Innkommende musikklenker åpnes i originalappen/nettleseren uten konvertering mens SongFlip er pauset."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkommande musiklänkar öppnas i originalappen/webbläsaren utan konvertering när SongFlip är pausad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomende muzieklinks openen in de oorspronkelijke app/browser zonder omzetting zolang SongFlip is gepauzeerd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens musicaux entrants s'ouvriront dans leur application/navigateur d'origine sans conversion pendant la pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de música entrantes se abrirán en su app/navegador original sin conversión mientras esté en pausa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link musicali in arrivo si apriranno nella loro app/browser originale senza conversione durante la pausa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links recebidos abrirão na app/navegador original sem conversão enquanto o SongFlip estiver em pausa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przychodzące linki muzyczne będą otwierane w oryginalnej aplikacji/przeglądarce bez konwersji podczas wstrzymania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки будут открываться в исходном приложении/браузере без конвертации, пока SongFlip на паузе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldığında gelen müzik bağlantıları dönüştürülmeden orijinal uygulamasında/tarayıcıda açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхідні посилання відкриватимуться в оригінальному додатку/браузері без конвертації під час паузи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中は、音楽リンクが変換されずに元のアプリまたはブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지된 동안 수신된 음악 링크는 변환 없이 원본 앱/브라우저에서 열립니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间，传入的音乐链接将在其原始应用/浏览器中打开，不进行转换。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间，传入的音乐链接将在其原始应用/浏览器中打开，不进行转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间，传入的音乐链接将在其原始应用/浏览器中打开，不进行转换。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik masuk akan terbuka di aplikasi/browser asli tanpa konversi saat dijeda."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan musik masuk akan terbuka di aplikasi/browser asli tanpa konversi saat dijeda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các liên kết đến sẽ mở trong ứng dụng/trình duyệt gốc mà không chuyển đổi khi đang tạm dừng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতির সময় ইনকামিং লিঙ্কগুলি রূপান্তর ছাড়াই আসল অ্যাপ/ব্রাউজারে খুলবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोके जाने पर आने वाले संगीत लिंक बिना किसी बदलाव के अपने मूल ऐप/ब्राउज़र में खुलेंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थांबवले असताना येणाऱ्या संगीत लिंक्स मूळ ॲप/ब्राउझरमध्ये कोणत्याही बदलाशिवाय उघडतील."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během pozastavení se příchozí hudební odkazy otevřou v původní aplikaci/prohlížeči bez převodu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά την παύση, οι εισερχόμενοι σύνδεσμοι θα ανοίγουν στην αρχική εφαρμογή/πρόγραμμα περιήγησης χωρίς μετατροπή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauon aikana saapuvat musiikkilinkit avautuvat alkuperäisessä sovelluksessa/selaimessa ilman muunnosta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szüneteltetés ideje alatt a bejövő zenei linkek az eredeti appban/böngészőben nyílnak meg átalakítás nélkül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timpul pauzei, linkurile muzicale primite se vor deschide în aplicația/browserul original fără conversie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะหยุดชั่วคราว ลิงก์เพลงขาเข้าจะเปิดในแอป/เบราว์เซอร์เดิมโดยไม่มีการแปลง"
          }
        }
      }
    },
