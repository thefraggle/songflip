            "value": "क्लिपबोर्ड से केवल 1 टैप में म्यूजिक लिंक बदलें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्डवरून फक्त एका टॅपमध्ये म्युझिक लिंक बदला."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převádějte hudební odkazy ze schránky jedním klepnutím."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετατρέψτε συνδέσμους μουσικής από το πρόχειρο με ένα μόνο πάτημα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muunna musiikkilinkit leikepöydältä yhdellä napautuksella."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenei linkek átalakítása a vágólapról egyetlen érintéssel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertește linkuri muzicale din clipboard cu o singură atingere."
          }
        },
        "th": {
