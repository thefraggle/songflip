        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从该歌单中提取曲目。您可以打开原始链接。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengekstrak trek dari daftar putar ini. Anda dapat membuka tautan asli sebagai gantinya."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengekstrak trek dari daftar putar ini. Anda dapat membuka tautan asli sebagai gantinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể trích xuất bài hát từ danh sách phát này. Bạn có thể mở liên kết gốc thay thế."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্লেলিস্ট থেকে গানগুলো নেওয়া যায়নি। আপনি চাইলে মূল লিঙ্কটি খুলতে পারেন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्लेलिस्ट से गाने निकाले नहीं जा सके। इसके बजाय आप मूल लिंक खोल सकते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्लेलिस्टवरून गाणी मिळवता आली नाहीत. आपण त्याऐवजी मूळ लिंक उघडू शकता."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tohoto playlistu se nepodařilo extrahovat skladby. Můžete otevřít původní odkaz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εξαγωγή κομματιών από αυτή τη λίστα. Μπορείτε να ανοίξετε τον αρχικό σύνδεσμο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleita ei voitu hakea tästä soittolistasta. Voit avata alkuperäisen linkin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült kinyerni a dalokat ebből a lejátszási listából. Megnyithatja az eredeti linket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au putut extrage piesele din acest playlist. Poți deschide linkul original."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดึงเพลงจากเพลย์ลิสต์นี้ คุณสามารถเปิดลิงก์เดิมแทนได้"
          }
        }
      }
    },
