        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 목록을 오른쪽 끝까지 스와이프하고 '더 보기'(⋯)를 탭하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 图标列表中向右滑到最末，轻点“更多”（⋯）。"
