    "•": {},
    "© 2026 Daniel Notthoff": {},
    "intent_description": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুলিপি করা বা শেয়ার করা মিউজিক লিঙ্ক রূপান্তর করে এবং লক্ষ্য অ্যাপটি খোলে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverterer et kopieret eller delt musiklink og åbner mål-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konvertiert einen kopierten oder übergebenen Musik-Link und öffnet die Ziel-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts a copied or shared music link and opens the target app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un enlace de música copiado o compartido y abre la app de destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertit un lien musical copié ou partagé et ouvre l'application cible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी या शेयर किए गए संगीत लिंक को बदलता है और लक्षित ऐप खोलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengonversi tautan musik yang disalin atau dibagikan dan membuka aplikasi tujuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte un link musicale copiato o condiviso e apre l'app di destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーまたは共有された音楽リンクを変換し、対象のアプリを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사되거나 공유된 음악 링크를 변환하고 대상 앱을 엽니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी केलेली किंवा शेअर केलेली संगीत लिंक रूपांतरित करते आणि लक्ष्य अॅप उघडते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverterer en kopiert eller delt musikklenke og åpner mål-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Converteert een gekopieerde of gedeelde muzieklink en opent de doel-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konwertuje skopiowany lub udostępniony link muzyczny i otwiera aplikację docelową."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte um link de música copiado ou compartilhado e abre o app de destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразует скопированную или переданную музыкальную ссылку и открывает целевое приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverterar en kopierad eller delad musiklänk och öppnar målappen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan veya paylaşılan bir müzik bağlantısını dönüştürür ve hedef uygulamayı açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертує скопійоване або надане музичне посилання та відкриває цільовий додаток."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển đổi liên kết âm nhạc đã sao chép hoặc chia sẻ và mở ứng dụng đích."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "转换复制或共享的音乐链接并打开目标应用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换复制或共享的音乐链接并打开目标应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉換複製或分享的音樂連結並打開目標應用程式。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převede zkopírovaný nebo sdílený hudební odkaz a otevře cílovou aplikaci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átalakítja a másolt vagy megosztott zenei linket, és megnyitja a célalkalmazást."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuntaa kopioidun tai jaetun musiikkilinkin ja avaa kohdesovelluksen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετατρέπει έναν αντιγραμμένο ή κοινόχρηστο σύνδεσμο μουσικής και ανοίγει την εφαρμογή προορισμού."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertește un link muzical copiat sau partajat și deschide aplicația țintă."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลงลิงก์เพลงที่คัดลอกหรือแชร์และเปิดแอปเป้าหมาย"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverterer en kopiert eller delt musikklenke og åpner mål-appen."
          }
        }
      }
    },
