    "soundcloud_target_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud bietet vor allem Remixe & Indie-Tracks. Nicht direkt gelistete Songs werden automatisch in der SoundCloud-Suche geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud focuses on remixes & indie tracks. Mainstream songs without a direct match open directly in SoundCloud search."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud fokuserer på remixes og indie-numre. Sange uden et direkte match åbnes automatisk i SoundCloud-søgningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud fokuserer på remikser og indie-låter. Sanger uten direkte treff åpnes automatisk i SoundCloud-søket."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud fokuserer på remikser og indie-låter. Sanger uten direkte treff åpnes automatisk i SoundCloud-søket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud fokuserar på remixar och indielåtar. Låtar utan direkt träff öppnas automatiskt i SoundCloud-sökningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud richt zich op remixes en indietracks. Nummers zonder directe match worden automatisch geopend in de SoundCloud-zoekopdracht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud privilégie les remix et titres indépendants. Les morceaux sans correspondance directe s'ouvrent dans la recherche SoundCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud se centra en remixes y pistas indie. Las canciones sin coincidencia directa se abren en la búsqueda de SoundCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud si concentra su remix e brani indie. I brani senza corrispondenza diretta vengono aperti nella ricerca di SoundCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SoundCloud foca-se em remixes e faixas indie. Músicas sem correspondência direta abrem automaticamente na pesquisa do SoundCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud skupia się na remiksach i utworach indie. Utwory bez bezpośredniego odpowiednika otwierają się w wyszukiwarce SoundCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud ориентирован на ремиксы и инди-треки. Песни без прямого совпадения открываются в поиске SoundCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud ağırlıklı olarak remiks ve bağımsız parçalar sunar. Doğrudan eşleşmeyen şarkılar SoundCloud aramasında açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud спеціалізується на реміксах та інді-треках. Пісні без прямого збігу відкриваються в пошуку SoundCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloudはリミックスやインディーズ曲が中心です。直接一致しない曲は自動的にSoundCloud検索で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud는 리믹스 및 인디 트랙 중심입니다. 직접 일치하지 않는 곡은 자동으로 SoundCloud 검색으로 열립니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud 主打混音与独立音乐。未直接匹配的歌曲将自动在 SoundCloud 搜索中打开。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud 主打混音与独立音乐。未直接匹配的歌曲将自动在 SoundCloud 搜索中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud 主打混音与独立音乐。未直接匹配的歌曲将自动在 SoundCloud 搜索中打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud berfokus pada remix & lagu indie. Lagu tanpa kecocokan langsung akan dibuka di pencarian SoundCloud."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud berfokus pada remix & lagu indie. Lagu tanpa kecocokan langsung akan dibuka di pencarian SoundCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud tập trung vào bản phối lại và nhạc indie. Bài hát không khớp trực tiếp sẽ tự động mở trong tìm kiếm SoundCloud."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud মূলত রিমিক্স ও ইন্ডি ট্র্যাকের জন্য পরিচিত। সরাসরি মিল না থাকা গানগুলো স্বয়ংক্রিয়ভাবে SoundCloud অনুসন্ধানে খুলবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud मुख्य रूप से रीमिक्स और इंडी ट्रैक पर केंद्रित है। सीधे मिलान न होने वाले गाने SoundCloud खोज में खुलते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud प्रामुख्याने रीमिक्स आणि इंडी ट्रॅकवर लक्ष केंद्रित करते. थेट न जुळणारी गाणी आपोआप SoundCloud शोधामध्ये उघडतात."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud se zaměřuje na remixy a indie skladby. Skladby bez přímé shody se automaticky otevřou ve vyhledávání SoundCloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SoundCloud εστιάζει σε remix και indie κομμάτια. Τραγούδια χωρίς άμεση αντιστοιχία ανοίγουν στην αναζήτηση του SoundCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud keskittyy remikseihin ja indie-kappaleisiin. Kappaleet, joille ei löydy suoraa vastinetta, avataan SoundCloud-haussa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SoundCloud főként remixekre és indie dalokra épül. A közvetlen egyezés nélküli dalok a SoundCloud keresőjében nyílnak meg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud se concentrează pe remixuri și piese indie. Melodiile fără corespondent direct se deschid în căutarea SoundCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundCloud เน้นเพลงรีมิกซ์และอินดี้ เพลงที่ไม่มีลิงก์ตรงจะถูกเปิดในหน้าค้นหาของ SoundCloud โดยอัตโนมัติ"
          }
        }
      }
    },
