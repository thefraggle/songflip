    "history_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Songs im Verlauf. Sobald du Musik-Links teilst, erscheinen sie hier."
          }
        },
        "en": {
