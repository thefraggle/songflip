    "pro_subscription_terms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch. Jederzeit in deinen Abo-Einstellungen kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically. Cancel anytime in your subscription settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk. Kan opsiges når som helst i dine abonnementsindstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk. Kan sies opp når som helst i abonnementsinnstillingene."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk. Kan sies opp når som helst i abonnementsinnstillingene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer förnyas automatiskt. Avsluta när som helst i dina prenumerationsinställningar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd. Op elk moment opzegbaar in je abonnementsinstellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement. Résiliable à tout moment dans les réglages d'abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente. Cancela cuando quieras en los ajustes de suscripción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente. Puoi disdire in qualsiasi momento nelle impostazioni dell'abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são renovadas automaticamente. Cancele quando quiser nas configurações de assinatura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie. Możesz anulować w dowolnym momencie w ustawieniach subskrypcji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически. Отменить можно в любой момент в настройках подписки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler otomatik olarak yenilenir. Abonelik ayarlarından istediğiniz zaman iptal edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки поновлюються автоматично. Скасувати можна будь-коли в налаштуваннях підписки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは自動更新されます。サブスクリプション設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 자동으로 갱신됩니다. 구독 설정에서 언제든지 해지할 수 있습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将自动续订。可随时在订阅设置中取消。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将自动续订。可随时在订阅设置中取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将自动续订。可随时在订阅设置中取消。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis. Batalkan kapan saja di pengaturan langganan."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis. Batalkan kapan saja di pengaturan langganan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký tự động gia hạn. Hủy bất cứ lúc nào trong phần cài đặt gói đăng ký."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রিপশন স্বয়ংক্রিয়ভাবে নবায়ন হয়। সাবস্ক্রিপশন সেটিংসে যেকোনো সময় বাতিল করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन अपने आप रिन्यू होते हैं। सब्सक्रिप्शन सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता आपोआप नूतनीकृत होते. सदस्यता सेटिंग्जमध्ये कधीही रद्द करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se automaticky obnovuje. Zrušit ho můžete kdykoli v nastavení předplatného."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές ανανεώνονται αυτόματα. Ακυρώστε οποτεδήποτε από τις ρυθμίσεις συνδρομής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset uusiutuvat automaattisesti. Voit peruuttaa milloin tahansa tilausasetuksista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések automatikusan megújulnak. Bármikor lemondhatod az előfizetési beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat. Le poți anula oricând din setările abonamentului."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะต่ออายุโดยอัตโนมัติ ยกเลิกได้ทุกเมื่อในการตั้งค่าการสมัครสมาชิก"
          }
        }
      }
    },
