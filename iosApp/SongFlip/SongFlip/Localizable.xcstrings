    "playlist_apple_music_no_import_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt keine externen Playlist-Links. Spiele Tracks einzeln unten ab oder exportiere die Playlist als M3U8/CSV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not support external playlist links. Play tracks individually below or export the playlist as M3U8/CSV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ understøtter ikke eksterne playlist-links. Afspil numre enkeltvis nedenfor eller eksporter playlisten som M3U8/CSV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ støtter ikke eksterne spillelistelenker. Spill av spor enkeltvis nedenfor eller eksporter spillelisten som M3U8/CSV."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ støtter ikke eksterne spillelistelenker. Spill av spor enkeltvis nedenfor eller eksporter spillelisten som M3U8/CSV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stöder inte externa spellänkar. Spela låtar enskilt nedan eller exportera spellistan som M3U8/CSV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ondersteunt geen externe afspeellijstlinks. Speel nummers hieronder afzonderlijk af of exporteer de afspeellijst als M3U8/CSV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas en charge les liens de playlists externes. Écoutez les morceaux individuellement ci-dessous ou exportez la playlist au format M3U8/CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite enlaces de listas de reproducción externas. Reproduce canciones individualmente abajo o exporta la lista como M3U8/CSV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non supporta link a playlist esterne. Riproduci i singoli brani qui sotto o esporta la playlist come M3U8/CSV."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não oferece suporte a links de playlists externas. Reproduza faixas individualmente abaixo ou exporte a playlist como M3U8/CSV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie obsługuje zewnętrznych linków do playlist. Odtwarzaj utwory pojedynczo poniżej lub wyeksportuj playlistę jako M3U8/CSV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не поддерживает внешние ссылки на плейлисты. Воспроизводите треки по отдельности ниже или экспортируйте плейлист в формате M3U8/CSV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ harici çalma listesi bağlantılarını desteklemiyor. Parçaları aşağıda tek tek çalın veya çalma listesini M3U8/CSV olarak dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не підтримує зовнішні посилання на плейлисти. Відтворюйте треки окремо нижче або експортуйте плейлист як M3U8/CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は外部プレイリストのリンクに対応していません。下のトラックを個別に再生するか、M3U8/CSVとして書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 외부 재생목록 링크를 지원하지 않습니다. 아래에서 트랙을 개별적으로 재생하거나 재생목록을 M3U8/CSV로 내보내세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不支持外部播放列表链接。请在下方单独播放歌曲，或将播放列表导出为 M3U8/CSV。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不支持外部播放列表链接。请在下方单独播放歌曲，或将播放列表导出为 M3U8/CSV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不支持外部播放列表链接。请在下方单独播放歌曲，或将播放列表导出为 M3U8/CSV。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak mendukung tautan daftar putar eksternal. Putar trek satu per satu di bawah atau ekspor daftar putar sebagai M3U8/CSV."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak mendukung tautan daftar putar eksternal. Putar trek satu per satu di bawah atau ekspor daftar putar sebagai M3U8/CSV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không hỗ trợ liên kết danh sách phát bên ngoài. Phát riêng lẻ từng bài hát bên dưới hoặc xuất danh sách phát dưới dạng M3U8/CSV."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ বাহ্যিক প্লেলিস্ট লিঙ্ক সমর্থন করে না। নীচে পৃথকভাবে ট্র্যাকগুলি চালান বা M3U8/CSV হিসাবে প্লেলিস্ট রপ্তানি করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाहरी प्लेलिस्ट लिंक का समर्थन नहीं करता है। नीचे अलग-अलग ट्रैक चलाएं या प्लेलिस्ट को M3U8/CSV के रूप में निर्यात करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाह्य प्लेलिस्ट लिंक्सचे समर्थन करत नाही. खाली स्वतंत्रपणे ट्रॅक प्ले करा किंवा M3U8/CSV म्हणून प्लेलिस्ट निर्यात करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nepodporuje externí odkazy na playlisty. Přehrávejte skladby jednotlivě níže nebo exportujte playlist jako M3U8/CSV."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν υποστηρίζει εξωτερικούς συνδέσμους λίστας αναπαραγωγής. Αναπαραγάγετε τα κομμάτια μεμονωμένα παρακάτω ή εξαγάγετε τη λίστα ως M3U8/CSV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei tue ulkoisia soittolinkkejä. Toista kappaleita erikseen alta tai vie soittolista M3U8/CSV-muodossa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ nem támogatja a külső lejátszási lista linkeket. Játssza le a dalokat egyenként lent, vagy exportálja a lejátszási listát M3U8/CSV formátumban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu acceptă linkuri către liste de redare externe. Redați melodiile individual mai jos sau exportați lista de redare ca M3U8/CSV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่รองรับลิงก์เพลย์ลิสต์ภายนอก เล่นแต่ละแทร็กทีละเพลงด้านล่าง หรือส่งออกเพลย์ลิสต์เป็น M3U8/CSV"
          }
        }
      }
    },
