    "playlist_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip currently supports single tracks and albums. Full playlist conversion is coming in a future update!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip unterstützt aktuell Einzelsongs und Alben. Der automatische Playlist-Konverter ist für ein kommendes Update geplant!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip actualmente es compatible con canciones y álbumes. ¡La conversión completa de listas llegará en una próxima actualización!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip prend actuellement en charge les titres et les albums. La conversion complète de playlists arrive dans une prochaine mise à jour !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip attualmente supporta singoli brani e album. La conversione completa delle playlist arriverà in un prossimo aggiornamento!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SongFlip atualmente suporta faixas e álbuns. A conversão completa de playlists chegará em uma próxima atualização!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip ondersteunt momenteel losse nummers en albums. Volledige conversie van afspeellijsten komt in een toekomstige update!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip obsługuje obecnie pojedyncze utwory i albumy. Pełna konwersja playlist pojawi się w nadchodzącej aktualizacji!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip understøtter i øjeblikket enkelte numre og album. Fuld konvertering af afspilningslister kommer i en fremtidig opdatering!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip stöder för närvarande enskilda låtar och album. Fullständig konvertering av spellistor kommer i en framtida uppdatering!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip støtter for øyeblikket enkeltspor og album. Full konvertering av spillelister kommer i en fremtidig oppdatering!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip støtter for øyeblikket enkeltspor og album. Full konvertering av spillelister kommer i en fremtidig oppdatering!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip şu anda tek parça ve albümleri desteklemektedir. Tam çalma listesi dönüştürme özelliği yakında gelecek!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip в настоящее время поддерживает отдельные треки и альбомы. Полная конвертация плейлистов появится в будущих обновлениях!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip наразі підтримує окремі треки та альбоми. Повна конвертація плейлістів з'явиться в наступних оновленнях!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlipは現在、シングル曲とアルバムのみに対応しています。プレイリストの一括変換は今後のアップデートで提供予定です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip은 현재 단일 트랙 및 앨범을 지원합니다. 전체 재생목록 변환 기능은 향후 업데이트에서 지원될 예정입니다!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 目前仅支持单曲和专辑。完整的播放列表转换功能将在后续更新中推出！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 目前仅支持单曲和专辑。完整的播放列表转换功能将在后续更新中推出！"
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip saat ini mendukung lagu tunggal dan album. Konversi daftar putar lengkap akan hadir di pembaruan mendatang!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip saat ini mendukung lagu tunggal dan album. Konversi daftar putar lengkap akan hadir di pembaruan mendatang!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip hiện hỗ trợ từng bài hát và album. Tính năng chuyển đổi toàn bộ danh sách phát sẽ có trong bản cập nhật sắp tới!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip वर्तमान में केवल गानों और एल्बम का समर्थन करता है। पूरी प्लेलिस्ट बदलने की सुविधा जल्द ही आएगी!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip বর্তমানে একক গান এবং অ্যালবাম সমর্থন করে। সম্পূর্ণ প্লেলিস্ট রূপান্তর শীঘ্রই আসছে!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip सध्या गाणी आणि अल्बमचे समर्थन करते. संपूर्ण प्लेलिस्ट रूपांतरण लवकरच येत आहे!"
          }
        }
      }
    },
