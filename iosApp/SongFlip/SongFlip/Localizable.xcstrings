          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: SongFlip werkt ook direct zonder configuratie via het deelmenu en klembord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : SongFlip fonctionne aussi instantanément sans configuration via le menu Partager et le presse-papiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: SongFlip también funciona al instante sin configuración mediante el menú Compartir y el portapapeles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: SongFlip funziona subito anche senza configurazione tramite menu Condividi e appunti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: O SongFlip também funciona instantaneamente sem configuração via menu Compartilhar e área de transferência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: SongFlip działa natychmiast bez konfiguracji za pośrednictwem menu Udostępnij i schowka."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка: SongFlip также работает мгновенно без настройки через меню «Поделиться» и буфер обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: SongFlip, Paylaş menüsü ve pano üzerinden kurulum yapmadan da anında çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порада: SongFlip також працює миттєво без налаштування через меню «Поділитися» та буфер обміну."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：共有シートやクリップボード経由なら、設定なしですぐに使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 공유 메뉴나 클립보드를 이용하면 설정 없이도 바로 사용할 수 있습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：通过“分享”菜单或直接复制链接，无需任何配置即可即刻使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：通过“分享”菜单或直接复制链接，无需任何配置即可即刻使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
