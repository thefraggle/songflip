    "target_service_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ziel-Dienst. Installierte Apps öffnen direkt, andere im Web-Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select where links should open. Installed apps open directly; others open in browser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvor links skal åbnes. Installerede apps åbnes direkte; andre i browseren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor lenker skal åpnes. Installerte apper åpnes direkte; andre i nettleseren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor lenker skal åpnes. Installerte apper åpnes direkte; andre i nettleseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj var länkar ska öppnas. Installerade appar öppnas direkt; andra i webbläsaren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar links moeten openen. Geïnstalleerde apps openen direct; andere in de browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez où les liens doivent s'ouvrir. Les applications installées s'ouvrent directement ; les autres dans le navigateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona dónde abrir los enlaces. Las apps instaladas se abren directamente; otras en el navegador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona dove aprire i link. Le app installate si aprono direttamente; le altre nel browser."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione onde os links devem abrir. Apps instaladas abrem diretamente; outras no navegador."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie mają otwierać się linki. Zainstalowane aplikacje otwierają się bezpośrednio; inne w przeglądarce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где открывать ссылки. Установленные приложения открываются напрямую, остальные — в браузере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıların nerede açılacağını seçin. Yüklü uygulamalar doğrudan açılır; diğerleri tarayıcıda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, де відкривати посилання. Встановлені додатки відкриваються напряму; інші — у браузері."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを開く場所を選択。インストール済みアプリは直接開き、その他はブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 열 대상 선택. 설치된 앱은 직접 열리고 나머지는 브라우저에서 열립니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择链接打开位置。已安装的应用直接打开；其他在浏览器中打开。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择链接打开位置。已安装的应用直接打开；其他在浏览器中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选择链接打开位置。已安装的应用直接打开；其他在浏览器中打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempat membuka tautan. Aplikasi terpasang terbuka langsung; lainnya di browser."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempat membuka tautan. Aplikasi terpasang terbuka langsung; lainnya di browser."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nơi mở liên kết. Ứng dụng đã cài đặt mở trực tiếp; ứng dụng khác mở trong trình duyệt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিঙ্কগুলি কোথায় খুলবে তা নির্বাচন করুন। ইনস্টল করা অ্যাপগুলি সরাসরি খোলে; অন্যগুলি ব্রাউজারে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि लिंक कहां खुलने चाहिए। इंस्टॉल किए गए ऐप्स सीधे खुलते हैं; अन्य ब्राउज़र में।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक्स कुठे उघडायच्या ते निवडा. इन्स्टॉल केलेले ॲप्स थेट उघडतात; इतर ब्राउझरमध्ये."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kde se mají odkazy otevírat. Nainstalované aplikace se otevřou přímo; ostatní v prohlížeči."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πού θα ανοίγουν οι σύνδεσμοι. Οι εγκατεστημένες εφαρμογές ανοίγουν απευθείας, οι άλλες στο πρόγραμμα περιήγησης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, missä linkit avataan. Asennetut sovellukset avautuvat suoraan, muut selaimessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, hol nyíljanak meg a linkek. A telepített appok közvetlenül nyílnak meg; a többi a böngészőben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați unde ar trebui să se deschidă linkurile. Aplicațiile instalate se deschid direct; altele în browser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตำแหน่งที่จะเปิดลิงก์ แอปที่ติดตั้งไว้จะเปิดโดยตรง แอปอื่นจะเปิดในเบราว์เซอร์"
          }
        }
      }
    },
    "target_soundcloud": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
