        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Android muzieklinks automatisch naar SongFlip te laten doorsturen, is een eenmalige bevestiging nodig. Volg deze 3 stappen:"
          }
        },
        "fr": {
          "stringUnit": {
