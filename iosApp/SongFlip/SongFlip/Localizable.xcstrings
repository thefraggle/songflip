            "state": "translated",
            "value": "Toque em Compartilhar no Spotify, Apple Music ou YouTube ➔ SongFlip para abrir direto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Udostępnij w Spotify, Apple Music lub YouTube ➔ SongFlip, aby od razu odtworzyć."
          }
        },
        "ru": {
          "stringUnit": {
