    "app_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalig einrichten – empfangene Musik-Links öffnen sich fortan automatisch im Hintergrund in deinem Lieblings-Player."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up once – shared music links automatically open in your preferred player in the background."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsæt én gang – delte musiklinks åbnes automatisk i din foretrukne afspiller i baggrunden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurer én gang – delte musikklenker åpnes automatisk i din favorittspiller i bakgrunnen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurer én gang – delte musikklenker åpnes automatisk i din favorittspiller i bakgrunnen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in en gång – delade musiklänkar öppnas automatiskt i din favoritspelare i bakgrunden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalig instellen – gedeelde muzieklinks openen automatisch in je favoriete speler op de achtergrond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez une seule fois : les liens musicaux partagés s'ouvrent automatiquement dans votre lecteur préféré en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configúralo una vez: los enlaces de música compartidos se abren automáticamente en tu reproductor favorito en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura una sola volta: i link musicali condivisi si aprono automaticamente nel tuo lettore preferito in background."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure uma vez: links de música partilhados abrem automaticamente no seu reprodutor favorito em segundo plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj raz – udostępnione linki muzyczne otwierają się automatycznie w Twoim ulubionym odtwarzaczu w tle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте один раз: полученные музыкальные ссылки автоматически открываются в вашем любимом плеере в фоновом режиме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez kurun: Paylaşılan müzik bağlantıları arka planda otomatik olarak tercih ettiğiniz oynatıcıda açılsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте один раз: отримані музичні посилання автоматично відкриваються у вашому улюбленому плеєрі у фоновому режимі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度設定するだけで、共有された音楽リンクがバックグラウンドでお好みのプレーヤーで自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 설정하세요. 공유된 음악 링크가 백그라운드에서 선호하는 플레이어로 자동 열립니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一次设置：分享的音乐链接会在后台自动以您偏好的播放器打开。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次设置：分享的音乐链接会在后台自动以您偏好的播放器打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次设置：分享的音乐链接会在后台自动以您偏好的播放器打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur sekali – tautan musik yang dibagikan otomatis terbuka di pemutar favorit Anda di latar belakang."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur sekali – tautan musik yang dibagikan otomatis terbuka di pemutar favorit Anda di latar belakang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt một lần – các liên kết âm nhạc được chia sẻ sẽ tự động mở trong trình phát yêu thích của bạn dưới nền."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার সেট আপ করুন – শেয়ার করা মিউজিক লিঙ্কগুলি ব্যাকগ্রাউন্ডে আপনার পছন্দের প্লেয়ারে স্বয়ংক্রিয়ভাবে খোলে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार सेट करें – साझा किए गए संगीत लिंक बैकग्राउंड में आपके पसंदीदा प्लेयर में स्वचालित रूप से खुलते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकदा सेट करा – शेअर केलेल्या संगीत लिंक्स पार्श्वभूमीत तुमच्या आवडत्या प्लेअरमध्ये आपोआप उघडतात."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte jednou – sdílené hudební odkazy se automaticky otevřou ve vašem oblíbeném přehrávači na pozadí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε το μία φορά – οι κοινόχρηστοι σύνδεσμοι μουσικής ανοίγουν αυτόματα στην εφαρμογή αναπαραγωγής σας στο παρασκήνιο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä kerran – jaetut musiikkilinkit avautuvat taustalla automaattisesti haluamassasi soittimessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be egyszer – a megosztott zenei linkek automatikusan megnyílnak a kívánt lejátszóban a háttérben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurează o singură dată – linkurile muzicale partajate se deschid automat în playerul preferat în fundal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าเพียงครั้งเดียว – ลิงก์เพลงที่แชร์จะเปิดในเครื่องเล่นที่คุณต้องการในเบื้องหลังโดยอัตโนมัติ"
          }
        }
      }
    },
    "app_links_alt_clipboard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
