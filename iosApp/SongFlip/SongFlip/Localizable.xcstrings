    "playlist_error_unsupported_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip unterstützt Playlists aktuell für Spotify, Apple Music, YouTube Music und Deezer. Einzelsongs dieser Plattform funktionieren weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip currently supports playlists for Spotify, Apple Music, YouTube Music, and Deezer. Single songs from this platform still work."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip understøtter i øjeblikket playlister fra Spotify, Apple Music, YouTube Music og Deezer. Enkelte sange fra denne platform virker stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip støtter for øyeblikket spillelister fra Spotify, Apple Music, YouTube Music og Deezer. Enkeltsanger fra denne plattformen fungerer fortsatt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip støtter for øyeblikket spillelister fra Spotify, Apple Music, YouTube Music og Deezer. Enkeltsanger fra denne plattformen fungerer fortsatt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip stöder för närvarande spellistor från Spotify, Apple Music, YouTube Music och Deezer. Enskilda låtar från den här plattformen fungerar fortfarande."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip ondersteunt momenteel playlists van Spotify, Apple Music, YouTube Music en Deezer. Losse nummers van dit platform werken nog steeds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip prend actuellement en charge les playlists Spotify, Apple Music, YouTube Music et Deezer. Les titres individuels de cette plateforme fonctionnent toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip admite actualmente playlists de Spotify, Apple Music, YouTube Music y Deezer. Las canciones sueltas de esta plataforma siguen funcionando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip supporta attualmente le playlist di Spotify, Apple Music, YouTube Music e Deezer. I singoli brani di questa piattaforma funzionano comunque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SongFlip suporta atualmente playlists do Spotify, Apple Music, YouTube Music e Deezer. Músicas individuais desta plataforma continuam a funcionar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip obsługuje obecnie playlisty ze Spotify, Apple Music, YouTube Music i Deezer. Pojedyncze utwory z tej platformy nadal działają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас SongFlip поддерживает плейлисты Spotify, Apple Music, YouTube Music и Deezer. Отдельные треки с этой платформы по-прежнему работают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip şu anda Spotify, Apple Music, YouTube Music ve Deezer çalma listelerini destekliyor. Bu platformdaki tekil şarkılar çalışmaya devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз SongFlip підтримує плейлисти Spotify, Apple Music, YouTube Music і Deezer. Окремі треки з цієї платформи й надалі працюють."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlipは現在、Spotify、Apple Music、YouTube Music、Deezerのプレイリストに対応しています。このサービスの単曲は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip은 현재 Spotify, Apple Music, YouTube Music, Deezer의 플레이리스트를 지원합니다. 이 플랫폼의 개별 곡은 계속 사용할 수 있습니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 目前支持 Spotify、Apple Music、YouTube Music 和 Deezer 的歌单。该平台的单曲仍可正常使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 目前支持 Spotify、Apple Music、YouTube Music 和 Deezer 的歌单。该平台的单曲仍可正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip 目前支持 Spotify、Apple Music、YouTube Music 和 Deezer 的歌单。该平台的单曲仍可正常使用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip saat ini mendukung playlist dari Spotify, Apple Music, YouTube Music, dan Deezer. Lagu satuan dari platform ini tetap berfungsi."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip saat ini mendukung playlist dari Spotify, Apple Music, YouTube Music, dan Deezer. Lagu satuan dari platform ini tetap berfungsi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip hiện hỗ trợ danh sách phát từ Spotify, Apple Music, YouTube Music và Deezer. Các bài hát lẻ từ nền tảng này vẫn hoạt động bình thường."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip বর্তমানে Spotify, Apple Music, YouTube Music এবং Deezer-এর প্লেলিস্ট সমর্থন করে। এই প্ল্যাটফর্মের একক গান এখনও কাজ করে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip अभी Spotify, Apple Music, YouTube Music और Deezer की प्लेलिस्ट सपोर्ट करता है। इस प्लेटफ़ॉर्म के एकल गाने अब भी काम करते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip सध्या Spotify, Apple Music, YouTube Music आणि Deezer च्या प्लेलिस्टना समर्थन देते. या प्लॅटफॉर्मवरील एकल गाणी अजूनही चालतात."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip aktuálně podporuje playlisty ze Spotify, Apple Music, YouTube Music a Deezer. Jednotlivé skladby z této platformy fungují dál."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SongFlip υποστηρίζει προς το παρόν λίστες από Spotify, Apple Music, YouTube Music και Deezer. Μεμονωμένα τραγούδια από αυτή την πλατφόρμα λειτουργούν κανονικά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip tukee tällä hetkellä soittolistoja Spotifysta, Apple Musicista, YouTube Musicista ja Deezeristä. Yksittäiset kappaleet tältä alustalta toimivat edelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SongFlip jelenleg a Spotify, az Apple Music, a YouTube Music és a Deezer lejátszási listáit támogatja. Az egyes dalok erről a platformról továbbra is működnek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SongFlip acceptă în prezent playlisturi din Spotify, Apple Music, YouTube Music și Deezer. Melodiile individuale de pe această platformă funcționează în continuare."
          }
        },
        "th": {
