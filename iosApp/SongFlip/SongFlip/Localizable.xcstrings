    "listen_no_match_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass die Musik laut genug ist, und versuche es erneut. Gratis-Scans zählen nur bei einem Treffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the music is loud enough and try again. Free scans are only counted when a song is found."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at musikken er høj nok, og prøv igen. Gratis scanninger tæller kun ved match."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at musikken er høy nok og prøv igjen. Gratis skanninger telles kun ved treff."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at musikken er høy nok og prøv igjen. Gratis skanninger telles kun ved treff."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att musiken är tillräckligt hög och försök igen. Gratis skanningar räknas bara vid träff."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat de muziek luid genoeg is en probeer het opnieuw. Gratis scans tellen alleen bij een match."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que la musique est assez forte et réessayez. Les scans gratuits ne comptent qu'en cas de succès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la música suene lo bastante fuerte e inténtalo de nuevo. Los escaneos gratis solo cuentan si hay coincidencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che la musica sia abbastanza alta e riprova. Le scansioni gratuite contano solo se il brano viene trovato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que a música esteja alta o suficiente e tente novamente. Scans grátis só contam quando há resultado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że muzyka jest wystarczająco głośna i spróbuj ponownie. Darmowe skany liczą się tylko przy trafieniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что музыка играет достаточно громко, и попробуйте снова. Бесплатные попытки списываются только при успехе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziğin yeterince yüksek olduğundan emin olup tekrar deneyin. Ücretsiz haklar yalnızca eşleşme bulunduğunda düşer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що музика грає достатньо гучно, і спробуйте ще раз. Безкоштовні спроби рахуються лише при збігу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽が十分に聞こえる場所で再試行してください。曲が見つからなかった場合、無料回数は消費されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 소리가 충분히 큰지 확인하고 다시 시도하세요. 무료 횟수는 곡을 찾았을 때만 차감됩니다."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保周围音乐足够清晰后重试。未识别成功不会消耗免费次数。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保周围音乐足够清晰后重试。未识别成功不会消耗免费次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保周围音乐足够清晰后重试。未识别成功不会消耗免费次数。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan musik cukup keras lalu coba lagi. Kuota gratis hanya dihitung jika lagu ditemukan."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan musik cukup keras lalu coba lagi. Kuota gratis hanya dihitung jika lagu ditemukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đảm bảo nhạc đủ lớn và thử lại. Lượt miễn phí chỉ tính khi tìm thấy bài hát."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গানটি যথেষ্ট জোরে বাজছে কিনা নিশ্চিত করে আবার চেষ্টা করুন। কেবল গান পাওয়া গেলেই ফ্রি স্ক্যান গণনা হয়।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि संगीत पर्याप्त तेज़ है और फिर से प्रयास करें। मुफ़्त स्कैन केवल गाना मिलने पर ही गिने जाते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत पुरेसे मोठे असल्याची खात्री करा आणि पुन्हा प्रयत्न करा. गाणे सापडल्यावरच मोफत स्कॅन मोजले जातात."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že hudba hraje dostatečně nahlas, a zkuste to znovu. Bezplatné skeny se počítají jen při nalezení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι η μουσική ακούγεται αρκετά δυνατά και δοκιμάστε ξανά. Οι δωρεάν σαρώσεις μετρούν μόνο αν βρεθεί τραγούδι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että musiikki kuuluu tarpeeksi kovaa ja yritä uudelleen. Ilmaiset kerrat kuluvat vain osumasta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződj meg róla, hogy a zene elég hangos, majd próbáld újra. Az ingyenes alkalmak csak találat esetén számítanak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigură-te că muzica se aude suficient de tare și încearcă din nou. Scanările gratuite se contorizează doar la găsire."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่าเสียงเพลงดังพอแล้วลองอีกครั้ง สิทธิ์สแกนฟรีจะนับเมื่อพบเพลงเท่านั้น"
          }
        }
      }
    },
