    "app_links_step2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake verfügbare Streaming-Dienste an. (Dein installierter Musik-Player ist von Android ausgegraut — das ist völlig normal und gewollt!)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick available streaming services. (Your installed music player is greyed out by Android — that is normal and optimal!)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér tilgængelige musiktjenester. (Din installerede musikafspiller er nedtonet af Android – det er helt normalt og optimalt!)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Huk av for tilgjengelige musikktjenester. (Din installerte musikkspiller er grået ut av Android – dette er helt normalt og optimalt!)"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Huk av for tilgjengelige musikktjenester. (Din installerte musikkspiller er grået ut av Android – dette er helt normalt og optimalt!)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera tillgängliga musiktjänster. (Din installerade musikspelare är gråmarkerad av Android – det är helt normalt och optimalt!)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink beschikbare muziekdiensten aan. (Je geïnstalleerde muziekspeler is grijs weergegeven door Android — dat is volkomen normaal en optimaal!)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les services disponibles. (Votre lecteur installé est grisé par Android — c'est tout à fait normal et optimal !)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca los servicios disponibles. (Tu reproductor instalado aparece atenuado por Android: ¡es totalmente normal y óptimo!)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona i servizi musicali disponibili. (Il tuo lettore installato è disattivato da Android: è assolutamente normale e corretto!)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os serviços disponíveis. (O seu reprodutor instalado aparece desativado pelo Android — isso é totalmente normal e ideal!)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz dostępne serwisy. (Twój zainstalowany odtwarzacz jest wyszarzony przez system Android — to całkowicie normalne i prawidłowe!)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте доступные сервисы. (Ваш установленный плеер выделен серым в Android — это абсолютно нормально и правильно!)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir servisleri işaretleyin. (Yüklü müzik çalarınız Android tarafından gri gösterilir — bu tamamen normaldir ve istenen durumdur!)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте доступні сервіси. (Ваш встановлений плеєр виділений сірим в Android — це абсолютно нормально й правильно!)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なサービスにチェックを入れます（インストール済みの再生アプリはAndroidによりグレーアウトされますが、正常な動作です）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 서비스를 선택하세요. (설치된 음악 플레이어는 Android에서 비활성화(회색)로 표시되며 이는 정상입니다!)"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选可用的音乐平台。（您已安装的播放器会被 Android 设为灰色，这是完全正常的且符合预期！）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选可用的音乐平台。（您已安装的播放器会被 Android 设为灰色，这是完全正常的且符合预期！）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选可用的音乐平台。（您已安装的播放器会被 Android 设为灰色，这是完全正常的且符合预期！）"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang layanan yang tersedia. (Pemutar musik Anda yang terinstal berwarna abu-abu oleh Android — itu normal dan memang semestinya!)"
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang layanan yang tersedia. (Pemutar musik Anda yang terinstal berwarna abu-abu oleh Android — itu normal dan memang semestinya!)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu các dịch vụ khả dụng. (Trình phát đã cài đặt của bạn bị làm mờ bởi Android — điều đó hoàn toàn bình thường và tối ưu!)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপলব্ধ পরিষেবাগুলিতে টিক দিন। (আপনার ইনস্টল করা প্লেয়ারটি Android দ্বারা ধূসর দেখাবে — এটি সম্পূর্ণ স্বাভাবিক এবং সঠিক!)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध सेवाओं को टिक करें। (आपका इंस्टॉल किया गया प्लेयर Android द्वारा धूसर (greyed out) है — यह बिल्कुल सामान्य और सही है!)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध सेवा निवडा. (तुमचा इन्स्टॉल केलेला म्युझिक प्लेअर Android द्वारे ग्रे (निष्क्रिय) दिसेल — हे पूर्णपणे सामान्य आहे!)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtněte dostupné služby. (Váš nainstalovaný přehrávač je v Androidu zašedlý — to je zcela normální a žádoucí!)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τις διαθέσιμες υπηρεσίες. (Η εγκατεστημένη εφαρμογή σας είναι απενεργοποιημένη από το Android — αυτό είναι απολύτως φυσιολογικό!)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse saatavilla olevat palvelut. (Asennettu musiikkisoittimesi on Androidissa harmaana — se on täysin normaalia ja toivottua!)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje be az elérhető szolgáltatásokat. (A telepített lejátszója szürkén jelenik meg az Androidban — ez teljesen normális és így a helyes!)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifați serviciile disponibile. (Playerul dvs. instalat este estompat de Android — este absolut normal și corect!)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกบริการที่มีให้ใช้งาน (เครื่องเล่นเพลงที่คุณติดตั้งไว้จะแสดงเป็นสีเทาใน Android ซึ่งเป็นเรื่องปกติและถูกต้องแล้ว!)"
          }
        }
      }
    },
