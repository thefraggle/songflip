          "stringUnit": {
            "state": "translated",
            "value": "Les liens de votre lecteur préféré (%@) n'ont pas besoin de redirection — configurez uniquement les autres services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de tu reproductor favorito (%@) no necesitan redirección; configura solo otros servicios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I collegamenti del tuo lettore preferito (%@) non necessitano di reindirizzamento: configura solo gli altri servizi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Links do seu reprodutor favorito (%@) não precisam de redirecionamento — configure apenas outros serviços."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki z Twojego ulubionego odtwarzacza (%@) nie wymagają przekierowania — skonfiguruj tylko inne usługi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки из вашего любимого плеера (%@) не требуют перенаправления — настраивайте только другие сервисы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori oynatıcınızdan (%@) gelen bağlantıların yönlendirilmesine gerek yoktur; yalnızca diğer servisleri yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання з вашого улюбленого плеєра (%@) не потребують перенаправлення — налаштуйте лише інші сервіси."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りプレーヤー (%@) のリンクは転送不要です。他のサービスのみ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 플레이어(%@)의 링크는 리디렉션할 필요가 없습니다. 다른 서비스만 설정하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "来自首选播放器 (%@) 的链接无需重定向 — 只需配置其他服务。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自首选播放器 (%@) 的链接无需重定向 — 只需配置其他服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "来自首选播放器 (%@) 的链接无需重定向 — 只需配置其他服务。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan dari pemutar favorit Anda (%@) tidak perlu dialihkan — cukup atur layanan lain."
          }
        },
        "in": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan dari pemutar favorit Anda (%@) tidak perlu dialihkan — cukup atur layanan lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết từ trình phát yêu thích (%@) không cần chuyển hướng — chỉ cần định cấu hình các dịch vụ khác."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রিয় প্লেয়ার (%@) থেকে লিঙ্ক পুনর্নির্দেশ করার প্রয়োজন নেই — কেবল অন্যান্য পরিষেবা কনফিগার করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पसंदीदा प्लेयर (%@) के लिंक को रीडायरेक्ट करने की आवश्यकता नहीं है — केवल अन्य सेवाओं को कॉन्फ़िगर करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या आवडत्या प्लेअरवरून (%@) लिंक्स पुनर्निर्देशित करण्याची आवश्यकता नाही — फक्त इतर सेवा कॉन्फिगर करा."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy z vašeho oblíbeného přehrávače (%@) nepotřebují přesměrování — nakonfigurujte pouze ostatní služby."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σύνδεσμοι από την αγαπημένη σας εφαρμογή (%@) δεν χρειάζονται ανακατεύθυνση — ρυθμίστε μόνο τις άλλες υπηρεσίες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkisoittimesi (%@) linkit eivät tarvitse uudelleenohjausta — määritä vain muut palvelut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvenc lejátszó (%@) linkjei nem igényelnek átirányítást — csak a többi szolgáltatást állítsa be."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile de la playerul preferat (%@) nu au nevoie de redirecționare — configurați doar celelalte servicii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จากเครื่องเล่นที่คุณชื่นชอบ (%@) ไม่จำเป็นต้องเปลี่ยนเส้นทาง — กำหนดค่าเฉพาะบริการอื่นเท่านั้น"
          }
        }
      }
    },
