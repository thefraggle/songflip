{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip bruger mikrofonen til at genkende musik omkring dig. Lyd optages eller gemmes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip nutzt das Mikrofon, um Musik in deiner Umgebung zu erkennen. Audiodaten werden niemals aufgezeichnet oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip uses the microphone to recognize music playing around you. Audio is never recorded or stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip usa el micrófono para reconocer la música a tu alrededor. El audio nunca se graba ni almacena."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip käyttää mikrofonia ympärilläsi soivan musiikin tunnistamiseen. Ääntä ei koskaan tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip utilise le micro pour reconnaître la musique autour de vous. Aucun enregistrement n'est stocké."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip usa il microfono per riconoscere la musica intorno a te. L'audio non viene mai registrato o salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flipは周囲で流れている音楽を認識するためにマイクを使用します。音声が録音または保存されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip은 주변에서 재생 중인 음악을 인식하기 위해 마이크를 사용합니다. 오디오는 절대 녹음되거나 저장되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip bruker mikrofonen til å gjenkjenne musikk rundt deg. Lyd tas aldri opp eller lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip gebruikt de microfoon om muziek om je heen te herkennen. Audio wordt nooit opgenomen of opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip bruker mikrofonen til å gjenkjenne musikk rundt deg. Lyd tas aldri opp eller lagres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip używa mikrofonu do rozpoznawania muzyki wokół Ciebie. Dźwięk nigdy nie jest nagrywany ani przechowywany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip usa o microfone para reconhecer a música ao seu redor. O áudio nunca é gravado ou armazenado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip использует микрофон для распознавания музыки вокруг вас. Аудиозаписи никогда не сохраняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip använder mikrofonen för att känna igen musik runt dig. Ljud spelas aldrig in eller sparas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip etrafınızdaki müziği tanımak için mikrofonu kullanır. Ses asla kaydedilmez veya saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip використовує мікрофон для розпізнавання музики навколо вас. Аудіо ніколи не записується і не зберігається."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip 使用麦克风识别周围播放的音乐。音频绝不会被录制或存储。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip používá mikrofon k rozpoznávání hudby v okolí. Zvuk se nikdy nenahrává ani neukládá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Listen & Flip χρησιμοποιεί το μικρόφωνο για την αναγνώριση μουσικής γύρω σας. Ο ήχος δεν καταγράφεται ούτε αποθηκεύεται ποτέ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Listen & Flip a mikrofont használja a környezetében szóló zene felismerésére. A hangot soha nem rögzítjük és nem tároljuk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip folosește microfonul pentru a recunoaște muzica din jur. Sunetul nu este niciodată înregistrat sau stocat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip ใช้ไมโครโฟนเพื่อจำแนกเพลงรอบตัวคุณ เสียงจะไม่ถูกบันทึกหรือจัดเก็บไว้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip sử dụng micrô để nhận diện nhạc đang phát xung quanh bạn. Âm thanh không bao giờ được ghi âm hoặc lưu trữ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip menggunakan mikrofon untuk mengenali musik di sekitar Anda. Audio tidak pernah direkam atau disimpan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip आपके आस-पास बज रहे संगीत को पहचानने के लिए माइक्रोफ़ोन का उपयोग करता है। ऑडियो कभी रिकॉर्ड या संग्रहीत नहीं किया जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip আপনার চারপাশের সঙ্গীত সনাক্ত করতে মাইক্রোফোন ব্যবহার করে। অডিও কখনই রেকর্ড বা সংরক্ষণ করা হয় না।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip तुमच्या सभोवतालचे संगीत ओळखण्यासाठी मायक्रोफोन वापरते. ऑडिओ कधीही रेकॉर्ड किंवा संग्रहित केला जात नाही."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Listen & Flip الميكروفون للتعرف على الموسيقى من حولك. لا يتم تسجيل الصوت أو تخزينه أبدًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen & Flip 使用麥克風識別周圍播放的音樂。音訊絕不會被錄製或儲存。"
          }
        }
      }
    }
  },
  "version": "1.0"
}