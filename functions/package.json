{
  "name": "songflip-functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "tsc && node --test lib/test/**/*.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "postdeploy": "python3 ../scripts/warmup_backend.py",
    "warmup": "python3 ../scripts/warmup_backend.py",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.9",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.1",
    "lru-cache": "^11.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "private": true
}
