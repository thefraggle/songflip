## Location of the Android SDK (automatically configured by Android Studio)
# sdk.dir=/path/to/your/android/sdk

# Optional API & Telemetry keys for development/testing
revenuecat.api.key=
aptabase.app.key=
aptabase.host=https://api.aptabase.com

# Optional proprietary cloud backend URLs (empty in open-source builds)
songflip.backend.cache.url=
songflip.backend.web.url=

# Optional Firebase App Check (Play Integrity) configuration (empty in open-source builds)
firebase.project.id=
firebase.app.id=
firebase.api.key=
