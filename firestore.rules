rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist collection for songflip.link
    match /waitlist/{document=**} {
      // Anyone can add an entry (waitlist signup)
      allow create: if true;
      // Only admin can read, update, or delete
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'daniel.notthoff@gmail.com';
    }

    // L2 Song Cache: accessed exclusively via backend Cloud Functions (Admin SDK)
    match /l2_song_cache/{hash} {
      allow read, write: if false;
    }

    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
